    <sys:String x:Key="Str_App_Header">Appearance &amp; Themes</sys:String>
    <sys:String x:Key="Str_App_Sub">Customize Windows / Linux chrome style, colorful themes, glass refraction, and accent palette</sys:String>
    <sys:String x:Key="Str_App_StyleGroup">Chrome &amp; Color Mode</sys:String>
