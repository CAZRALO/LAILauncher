    <sys:String x:Key="Str_WifiModal_Title">Connect to Wi-Fi Network</sys:String>
    <sys:String x:Key="Str_WifiModal_Desc">Enter the network security key (WPA2/WPA3) to create a profile and connect directly:</sys:String>
    <sys:String x:Key="Str_WifiModal_Cancel">Cancel (Esc)</sys:String>
    <sys:String x:Key="Str_WifiModal_Connect">Connect</sys:String>

