    <sys:String x:Key="Str_Apps_TrayDesc">Keep LAILauncher accessible from the Windows notification area</sys:String>
    <sys:String x:Key="Str_Apps_MinToTrayTitle">Minimize to Tray instead of quitting</sys:String>
