    <sys:String x:Key="Str_Gen_ApplyHotkey">Apply</sys:String>
    <sys:String x:Key="Str_Gen_StartupGroup">System Startup</sys:String>
    <sys:String x:Key="Str_Gen_StartupTitle">Launch at Windows startup</sys:String>
    <sys:String x:Key="Str_Gen_StartupDesc">Start silently in the system tray when you sign in</sys:String>

