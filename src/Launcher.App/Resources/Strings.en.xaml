    <sys:String x:Key="Str_Apps_IndexGroup">Application &amp; File Indexer</sys:String>
    <sys:String x:Key="Str_Apps_IndexTitle">Local SQLite Search Index</sys:String>
    <sys:String x:Key="Str_Apps_ReindexApps">Re-index Apps</sys:String>
    <sys:String x:Key="Str_Apps_ReindexFiles">Re-index Files</sys:String>
    <sys:String x:Key="Str_Apps_ProcGroup">Background Processes Manager</sys:String>
    <sys:String x:Key="Str_Apps_ProcSub">Inspect active processes by RAM usage and safely terminate unresponsive background apps</sys:String>

