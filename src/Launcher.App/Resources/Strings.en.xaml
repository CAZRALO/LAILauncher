    <sys:String x:Key="Str_Sys_Header">Windows System Controls</sys:String>
    <sys:String x:Key="Str_Sys_Sub">Control Wi-Fi, Bluetooth, Battery Saver, Audio Volume, Display, and Taskbar directly in-app</sys:String>

