    <sys:String x:Key="Str_Btn_MinimizeTooltip">Minimize (hide launcher)</sys:String>
    <sys:String x:Key="Str_Btn_MaximizeTooltip">Maximize / Restore</sys:String>
    <sys:String x:Key="Str_Btn_CloseTooltip">Close (Esc)</sys:String>
    <sys:String x:Key="Str_Btn_SettingsTooltip">Theme &amp; System Settings (Ctrl+,)</sys:String>
    <sys:String x:Key="Str_Btn_ModeTooltip">Switch Light / Dark Mode (Ctrl + D)</sys:String>
    <sys:String x:Key="Str_Btn_OsTooltip">Switch Window Style: Windows Fluent ↔ Linux GNOME (Ctrl+Alt+L)</sys:String>
