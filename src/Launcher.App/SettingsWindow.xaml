<Window x:Class="Launcher.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{DynamicResource Str_SettingsTitle}"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="660" Width="960"
        MinHeight="540" MinWidth="780"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        KeyDown="OnWindowKeyDown"
        StateChanged="OnWindowStateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="12"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Left Sidebar Navigation RadioButton Style (MusicBar Win11 / GNOME pattern) -->
        <Style x:Key="NavTabRadioStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="SettingsNavGroup"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="navBd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="10,0">
                            <Grid>
                                <Border x:Name="activePill"
                                        Width="3" Height="18"
                                        CornerRadius="1.5"
                                        Background="{DynamicResource AccentBrush}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="-8,0,0,0"
                                        Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="navBd" Property="Background" Value="{DynamicResource SubtleHoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="navBd" Property="Background" Value="{DynamicResource ItemSelectedBgBrush}"/>
                                <Setter TargetName="activePill" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MusicBar Setting Card Container -->
        <Style x:Key="SettingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Section Header Label Style -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="2,14,0,8"/>
        </Style>

        <!-- Compact Pill Radio Style -->
        <Style x:Key="ThemeCardRadioStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="cardBorder"
                                Background="{DynamicResource SearchBarBgBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1.2"
                                CornerRadius="7"
                                Padding="10,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="cardBorder" Property="Background" Value="{DynamicResource ItemHoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="cardBorder" Property="Background" Value="{DynamicResource ItemSelectedBgBrush}"/>
                                <Setter TargetName="cardBorder" Property="BorderThickness" Value="1.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Theme Preset Swatch Card Style (3x4 Grid) -->
        <Style x:Key="ThemeSwatchRadioStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="ThemePresetGroup"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="swatchBorder"
                                Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1.2"
                                CornerRadius="9"
                                Padding="11,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="swatchBorder" Property="Background" Value="{DynamicResource ItemHoverBgBrush}"/>
                                <Setter TargetName="swatchBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="swatchBorder" Property="Background" Value="{DynamicResource ItemSelectedBgBrush}"/>
                                <Setter TargetName="swatchBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="swatchBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular Color Swatch Button (MusicBar style) -->
        <Style x:Key="AccentChipStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,7,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chipBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chipBorder" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter TargetName="chipBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Subtle Action Button -->
        <Style x:Key="SubtleBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBgBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Primary Button -->
        <Style x:Key="AccentBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Modern Slider -->
        <Style x:Key="ModernSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center">
                            <Border Height="5" CornerRadius="2.5" Background="{DynamicResource SearchBarBgBrush}" BorderBrush="{DynamicResource SearchBarBorderBrush}" BorderThickness="1"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" CornerRadius="2.5" Background="{DynamicResource AccentBrush}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="16" Height="16" CornerRadius="8" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource SurfaceElevatedBrush}" BorderThickness="2.5" Cursor="Hand">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.3"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootWindowBorder"
            Background="{DynamicResource WindowBgBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="{DynamicResource WindowBorderThickness}"
            CornerRadius="{DynamicResource WindowCornerRadius}"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270"
                              Color="{DynamicResource ShadowColor}"
                              Opacity="{DynamicResource ShadowOpacity}"/>
        </Border.Effect>

        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/> <!-- Titlebar -->
                <RowDefinition Height="*"/>  <!-- Sidebar + Detail Pane -->
            </Grid.RowDefinitions>

            <!-- Specular Top Highlight -->
            <Border Grid.Row="0" Height="1.5" VerticalAlignment="Top"
                    Background="{DynamicResource GlassSpecularBrush}"
                    CornerRadius="{DynamicResource WindowCornerRadiusTop}"
                    IsHitTestVisible="False"/>

            <!-- 1. CUSTOM WINDOW TITLEBAR (Windows 11 / Linux GNOME) -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SidebarBgBrush}"
                    BorderBrush="{DynamicResource SeparatorBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="{DynamicResource WindowCornerRadiusTop}"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Linux Traffic Light Dots (Left) -->
                    <StackPanel x:Name="LinuxTrafficDots" Grid.Column="0" Orientation="Horizontal" Visibility="{DynamicResource LinuxVisibility}" Margin="14,0,6,0" VerticalAlignment="Center">
                        <Button Width="13" Height="13" Margin="0,0,8,0" Click="OnCloseClicked" ToolTip="{DynamicResource Str_Btn_CloseTooltip}" Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="6.5" Background="#FF5F56" BorderBrush="#E0443E" BorderThickness="0.8">
                                        <Path x:Name="g" Data="{StaticResource GeoClear}" Stroke="#440000" StrokeThickness="1.2" Width="6" Height="6" Stretch="Uniform" Visibility="Collapsed"/>
                                    </Border>
                                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="g" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="13" Height="13" Margin="0,0,8,0" Click="OnMinimizeClicked" ToolTip="{DynamicResource Str_Btn_MinimizeTooltip}" Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="6.5" Background="#FFBD2E" BorderBrush="#DEA123" BorderThickness="0.8">
                                        <Path x:Name="g" Data="{StaticResource GeoMinimize}" Stroke="#443000" StrokeThickness="1.2" Width="6" Height="6" Stretch="Uniform" Visibility="Collapsed"/>
                                    </Border>
                                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="g" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="13" Height="13" Click="OnMaximizeRestoreClicked" ToolTip="{DynamicResource Str_Btn_MaximizeTooltip}" Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="6.5" Background="#27C93F" BorderBrush="#1AAB29" BorderThickness="0.8">
                                        <Path x:Name="g" Data="{StaticResource GeoMaximize}" Stroke="#003300" StrokeThickness="1.2" Width="6" Height="6" Stretch="Uniform" Visibility="Collapsed"/>
                                    </Border>
                                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="g" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- App Title + Brand Icon -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Visibility="{DynamicResource WindowsVisibility}">
                        <Image Source="pack://application:,,,/Assets/app-logo.png" Width="17" Height="17" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{DynamicResource Str_SettingsTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Centered Title for Linux GNOME Style -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{DynamicResource LinuxVisibility}">
                        <Image Source="pack://application:,,,/Assets/app-logo.png" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{DynamicResource Str_SettingsTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Windows Caption Controls (Minimize / Maximize-Restore / Close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Visibility="{DynamicResource WindowsVisibility}" VerticalAlignment="Stretch">
                        <Button x:Name="SettingsMinBtn" Width="44" Click="OnMinimizeClicked" ToolTip="{DynamicResource Str_Btn_MinimizeTooltip}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                                        <Path Data="{StaticResource GeoMinimize}" Width="10" Height="10" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.3" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource SubtleHoverBgBrush}"/></Trigger></ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="SettingsMaxBtn" Width="44" Click="OnMaximizeRestoreClicked" ToolTip="{DynamicResource Str_Btn_MaximizeTooltip}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                                        <Path x:Name="SettingsMaxIcon" Data="{StaticResource GeoMaximize}" Width="10" Height="10" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.3" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource SubtleHoverBgBrush}"/></Trigger></ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="SettingsCloseBtn" Width="46" Click="OnCloseClicked" ToolTip="{DynamicResource Str_Btn_CloseTooltip}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                                        <Path x:Name="cp" Data="{StaticResource GeoClear}" Width="10" Height="10" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.4" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                            <Setter TargetName="cp" Property="Stroke" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. MASTER-DETAIL WORKSPACE -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDEBAR (MusicBar Windows 11 / GNOME Navigation Rail) -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SidebarBgBrush}"
                        BorderBrush="{DynamicResource SeparatorBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="12,14,12,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Brand Info -->
                            <RowDefinition Height="Auto"/> <!-- Language Picker -->
                            <RowDefinition Height="*"/>    <!-- Nav Links -->
                            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                        </Grid.RowDefinitions>

                        <!-- Sidebar App Brand Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,2,6,14">
                            <Image Source="pack://application:,,,/Assets/app-logo.png" Width="34" Height="34" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str_AppName}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{DynamicResource Str_Version}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Language Selector Pill Row (Direct MusicBar pattern) -->
                        <Grid Grid.Row="1" Margin="4,0,4,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource GeoGlobe}" Width="16" Height="16" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" VerticalAlignment="Center" Margin="6,0,10,0"/>
                            <ComboBox Grid.Column="1" x:Name="LanguageComboBox" Height="34" SelectionChanged="OnLanguageSelectionChanged">
                                <ComboBoxItem Tag="vi" Content="Tiếng Việt"/>
                                <ComboBoxItem Tag="en" Content="English"/>
                            </ComboBox>
                        </Grid>

                        <!-- Vertical Tab Navigation List -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <RadioButton x:Name="NavGeneralRadio" Tag="0" IsChecked="True" Click="OnNavTabClicked" Style="{StaticResource NavTabRadioStyle}">
                                    <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                                        <Path Data="{StaticResource GeoSliders}" Width="15" Height="15" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Str_Nav_General}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="NavAppearanceRadio" Tag="1" Click="OnNavTabClicked" Style="{StaticResource NavTabRadioStyle}">
                                    <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                                        <Path Data="{StaticResource GeoPalette}" Width="15" Height="15" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Str_Nav_Appearance}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="NavWindowRadio" Tag="2" Click="OnNavTabClicked" Style="{StaticResource NavTabRadioStyle}">
                                    <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                                        <Path Data="{StaticResource GeoWindowSize}" Width="15" Height="15" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Str_Nav_Window}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="NavAppsRadio" Tag="3" Click="OnNavTabClicked" Style="{StaticResource NavTabRadioStyle}">
                                    <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                                        <Path Data="{StaticResource GeoApps}" Width="15" Height="15" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Str_Nav_Apps}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="NavSystemRadio" Tag="4" Click="OnNavTabClicked" Style="{StaticResource NavTabRadioStyle}">
                                    <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                                        <Path Data="{StaticResource GeoMonitor}" Width="15" Height="15" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Str_Nav_System}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="NavAIRadio" Tag="5" Click="OnNavTabClicked" Style="{StaticResource NavTabRadioStyle}">
                                    <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                                        <Path Data="{StaticResource GeoSparkle}" Width="15" Height="15" Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Str_Nav_AI}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="NavAboutRadio" Tag="6" Click="OnNavTabClicked" Style="{StaticResource NavTabRadioStyle}">
                                    <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                                        <Path Data="{StaticResource GeoAbout}" Width="15" Height="15" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Str_Nav_About}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Sidebar Bottom Quick Footer Actions -->
                        <Grid Grid.Row="3" Margin="4,12,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{DynamicResource Str_Btn_RestartApp}" Click="OnRestartClicked" Style="{StaticResource SubtleBtnStyle}" Margin="0,0,4,0" Padding="8,7"/>
                            <Button Grid.Column="1" Content="{DynamicResource Str_Btn_SaveClose}" Click="OnSaveAndCloseClicked" Style="{StaticResource AccentBtnStyle}" Margin="4,0,0,0" Padding="8,7"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- RIGHT CONTENT PANE -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="26,20,28,26">
                    <StackPanel>

                        <!-- ==================== TAB 0: GENERAL ==================== -->
                        <StackPanel x:Name="PanelGeneral" Visibility="Visible">
                            <TextBlock Text="{DynamicResource Str_Gen_Header}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Str_Gen_Sub}" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,14"/>

                            <TextBlock Text="{DynamicResource Str_Gen_HotkeyGroup}" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Style="{StaticResource SettingCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="210"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{StaticResource GeoRocket}" Width="18" Height="18" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Str_Gen_HotkeyTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{DynamicResource Str_Gen_HotkeyDesc}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="HotkeyPresetCombo" Grid.Column="2" Height="34" SelectionChanged="OnHotkeyPresetChanged">
                                            <ComboBoxItem Content="Alt + Space"/>
                                            <ComboBoxItem Content="Ctrl + Space"/>
                                            <ComboBoxItem Content="Win + Space"/>
                                            <ComboBoxItem Content="Alt + K"/>
                                            <ComboBoxItem Content="Ctrl + Shift + Space"/>
                                            <ComboBoxItem Content="Tùy chỉnh (Custom)..."/>
                                        </ComboBox>
                                    </Grid>

                                    <StackPanel x:Name="CustomHotkeyPanel" Visibility="Collapsed" Margin="32,12,0,0">
                                        <TextBlock Text="{DynamicResource Str_Gen_CustomHotkeyDesc}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="CustomHotkeyBox" Grid.Column="0" IsReadOnly="True" Padding="10,7" Background="{DynamicResource SearchBarBgBrush}" BorderBrush="{DynamicResource SearchBarBorderBrush}" BorderThickness="1" Foreground="{DynamicResource TextPrimaryBrush}" PreviewKeyDown="OnCustomHotkeyPreviewKeyDown"/>
                                            <Button Grid.Column="1" Content="{DynamicResource Str_Gen_ApplyHotkey}" Click="OnApplyCustomHotkeyClicked" Style="{StaticResource AccentBtnStyle}" Margin="8,0,0,0"/>
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock x:Name="HotkeyStatusText" Text="" FontSize="11.5" Foreground="{DynamicResource AccentBrush}" Margin="32,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{DynamicResource Str_Gen_StartupGroup}" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource GeoPower}" Width="18" Height="18" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str_Gen_StartupTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource Str_Gen_StartupDesc}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="AutoStartCheckBox" Grid.Column="2" Style="{StaticResource FluentToggleSwitchStyle}" Checked="OnAutoStartToggled" Unchecked="OnAutoStartToggled"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ==================== TAB 1: APPEARANCE & THEMES ==================== -->
                        <StackPanel x:Name="PanelAppearance" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Str_App_Header}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Str_App_Sub}" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,14"/>

                            <TextBlock Text="{DynamicResource Str_App_StyleGroup}" Style="{StaticResource SectionTitleStyle}"/>
                            <!-- OS Style & Color Mode Cards -->
                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource GeoWindows}" Width="18" Height="18" Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{DynamicResource Str_App_OsTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource Str_App_OsDesc}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="OsStyleWindowsRadio" GroupName="OsGroup" Content="Windows Fluent" Click="OnOsStyleSelectionChanged" Style="{StaticResource ThemeCardRadioStyle}"/>
                                        <RadioButton x:Name="OsStyleLinuxRadio" GroupName="OsGroup" Content="Linux GNOME" Click="OnOsStyleSelectionChanged" Style="{StaticResource ThemeCardRadioStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource GeoMoon}" Width="18" Height="18" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{DynamicResource Str_App_ModeTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource Str_App_ModeDesc}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="ModeForceDarkRadio" GroupName="ModeGroup" Content="{DynamicResource Str_App_ModeDark}" Click="OnDualModeSelectionChanged" Style="{StaticResource ThemeCardRadioStyle}"/>
                                        <RadioButton x:Name="ModeForceLightRadio" GroupName="ModeGroup" Content="{DynamicResource Str_App_ModeLight}" Click="OnDualModeSelectionChanged" Style="{StaticResource ThemeCardRadioStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Path Data="{StaticResource GeoLayout}" Width="17" Height="17" Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str_App_LayoutTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{DynamicResource Str_App_LayoutDesc}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <WrapPanel>
                                        <RadioButton x:Name="UiStyleModernRadio" GroupName="UiStyleGroup" Content="Modern Glass" Click="OnUiStyleSelectionChanged" Style="{StaticResource ThemeCardRadioStyle}"/>
                                        <RadioButton x:Name="UiStyleCompactRadio" GroupName="UiStyleGroup" Content="Compact" Click="OnUiStyleSelectionChanged" Style="{StaticResource ThemeCardRadioStyle}"/>
                                        <RadioButton x:Name="UiStyleSharpRadio" GroupName="UiStyleGroup" Content="Cyber Sharp" Click="OnUiStyleSelectionChanged" Style="{StaticResource ThemeCardRadioStyle}"/>
                                        <RadioButton x:Name="UiStylePillRadio" GroupName="UiStyleGroup" Content="Pill Floating" Click="OnUiStyleSelectionChanged" Style="{StaticResource ThemeCardRadioStyle}"/>
                                        <RadioButton x:Name="UiStyleClassicRadio" GroupName="UiStyleGroup" Content="Classic Card" Click="OnUiStyleSelectionChanged" Style="{StaticResource ThemeCardRadioStyle}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- 12 Theme Preset Swatch Cards -->
                            <TextBlock Text="{DynamicResource Str_App_ThemesGroup}" Style="{StaticResource SectionTitleStyle}"/>
                            <UniformGrid Columns="3" Margin="-4,0,-4,6">
                                <!-- Row 1: Windows Classics & Modern + System -->
                                <RadioButton x:Name="ThemeWin11Radio" Click="OnThemeChanged" Style="{StaticResource ThemeSwatchRadioStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="22" Height="22" CornerRadius="11" Background="#0078D4" BorderBrush="#60CDFF" BorderThickness="2" Margin="0,0,10,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Windows 11" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Mica Fluent" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="ThemeWin10Radio" Click="OnThemeChanged" Style="{StaticResource ThemeSwatchRadioStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="22" Height="22" CornerRadius="4" Background="#0078D7" BorderBrush="#38BDF8" BorderThickness="2" Margin="0,0,10,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Windows 10" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Metro Crisp" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="ThemeVistaRadio" Click="OnThemeChanged" Style="{StaticResource ThemeSwatchRadioStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="22" Height="22" CornerRadius="11" BorderBrush="#7DD3FC" BorderThickness="2" Margin="0,0,10,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#7DD3FC" Offset="0"/>
                                                    <GradientStop Color="#0284C7" Offset="0.5"/>
                                                    <GradientStop Color="#0B3B60" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="Windows Vista" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Frutiger Aero" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>

                                <!-- Row 2: System, Ubuntu, Arch -->
                                <RadioButton x:Name="ThemeSystemRadio" Click="OnThemeChanged" Style="{StaticResource ThemeSwatchRadioStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="22" Height="22" CornerRadius="11" Background="#0EA5E9" BorderBrush="#E2E8F0" BorderThickness="2" Margin="0,0,10,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Windows Sync" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Auto Accent" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="ThemeUbuntuRadio" Click="OnThemeChanged" Style="{StaticResource ThemeSwatchRadioStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="22" Height="22" CornerRadius="11" Background="#E95420" BorderBrush="#FDBA74" BorderThickness="2" Margin="0,0,10,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Ubuntu Yaru" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="GNOME Warm" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="ThemeArchRadio" Click="OnThemeChanged" Style="{StaticResource ThemeSwatchRadioStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="22" Height="22" CornerRadius="11" Background="#00AAD4" BorderBrush="#7DD3FC" BorderThickness="2" Margin="0,0,10,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Arch Cyan" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="GNOME Cool" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>

                                <!-- Row 3: Aurora, Cyberpunk, Nord -->
                                <RadioButton x:Name="ThemeAuroraRadio" Click="OnThemeChanged" Style="{StaticResource ThemeSwatchRadioStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="22" Height="22" CornerRadius="11" Background="#8B5CF6" BorderBrush="#C4B5FD" BorderThickness="2" Margin="0,0,10,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Liquid Aurora" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Violet Mist" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="ThemeCyberpunkRadio" Click="OnThemeChanged" Style="{StaticResource ThemeSwatchRadioStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="22" Height="22" CornerRadius="11" Background="#F43F5E" BorderBrush="#FDA4AF" BorderThickness="2" Margin="0,0,10,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Cyberpunk Neon" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Rose Synth" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="ThemeNordRadio" Click="OnThemeChanged" Style="{StaticResource ThemeSwatchRadioStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="22" Height="22" CornerRadius="11" Background="#88C0D0" BorderBrush="#D8DEE9" BorderThickness="2" Margin="0,0,10,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Nord Frost" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Arctic Slate" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>

                                <!-- Row 4: Dracula, Emerald, Sunset -->
                                <RadioButton x:Name="ThemeDraculaRadio" Click="OnThemeChanged" Style="{StaticResource ThemeSwatchRadioStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="22" Height="22" CornerRadius="11" Background="#BD93F9" BorderBrush="#FF79C6" BorderThickness="2" Margin="0,0,10,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Dracula" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Nocturne Lilac" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="ThemeEmeraldRadio" Click="OnThemeChanged" Style="{StaticResource ThemeSwatchRadioStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="22" Height="22" CornerRadius="11" Background="#10B981" BorderBrush="#6EE7B7" BorderThickness="2" Margin="0,0,10,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Emerald Mint" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Jade Breeze" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="ThemeSunsetRadio" Click="OnThemeChanged" Style="{StaticResource ThemeSwatchRadioStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="22" Height="22" CornerRadius="11" Background="#FB923C" BorderBrush="#FED7AA" BorderThickness="2" Margin="0,0,10,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Sunset Coral" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Peach Glow" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>

                            <!-- Glass Settings (MusicBar Slider + Switch Cards) -->
                            <TextBlock Text="{DynamicResource Str_App_GlassGroup}" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource GeoGlass}" Width="18" Height="18" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str_App_GlassEnableTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource Str_App_GlassEnableDesc}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="EnableGlassCheckBox" Grid.Column="2" Style="{StaticResource FluentToggleSwitchStyle}" Checked="OnEnableGlassChanged" Unchecked="OnEnableGlassChanged"/>
                                </Grid>
                            </Border>

                            <StackPanel x:Name="GlassOptionsPanel">
                                <Border Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="46"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{StaticResource GeoBrightness}" Width="18" Height="18" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Str_App_OpacityTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{DynamicResource Str_App_OpacityDesc}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                        <Slider x:Name="GlassOpacitySlider" Grid.Column="2" Minimum="35" Maximum="98" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="12,0" Style="{StaticResource ModernSliderStyle}" ValueChanged="OnGlassOpacityChanged"/>
                                        <TextBlock x:Name="GlassOpacityText" Grid.Column="3" Text="85%" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{StaticResource GeoPalette}" Width="18" Height="18" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Str_App_TintAccentTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{DynamicResource Str_App_TintAccentDesc}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="GlassTintWithAccentCheckBox" Grid.Column="2" Style="{StaticResource FluentToggleSwitchStyle}" Checked="OnGlassTintWithAccentChanged" Unchecked="OnGlassTintWithAccentChanged"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="ManualGlassTintPanel" Style="{StaticResource SettingCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{StaticResource GeoPalette}" Width="18" Height="18" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Str_App_TintCustomTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Button Tag="#0B132B" Click="OnPresetGlassTintClicked" Style="{StaticResource AccentChipStyle}" Background="#0B132B" ToolTip="Midnight"/>
                                                <Button Tag="#102B42" Click="OnPresetGlassTintClicked" Style="{StaticResource AccentChipStyle}" Background="#102B42" ToolTip="Vista Aero"/>
                                                <Button Tag="#1E1322" Click="OnPresetGlassTintClicked" Style="{StaticResource AccentChipStyle}" Background="#1E1322" ToolTip="Aubergine"/>
                                                <Button Tag="#0C1814" Click="OnPresetGlassTintClicked" Style="{StaticResource AccentChipStyle}" Background="#0C1814" ToolTip="Deep Emerald"/>
                                                <Button Tag="#DDEAF9" Click="OnPresetGlassTintClicked" Style="{StaticResource AccentChipStyle}" Background="#DDEAF9" ToolTip="Sky Ice"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border x:Name="GlassTintPreviewSwatch" Width="26" Height="26" CornerRadius="6" Background="#0F121C" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,6,0"/>
                                            <TextBox x:Name="CustomGlassTintTextBox" Width="88" Padding="8,5" FontSize="12" Background="{DynamicResource SearchBarBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource SearchBarBorderBrush}" BorderThickness="1" TextChanged="OnCustomGlassTintTextChanged"/>
                                            <Button Content="{DynamicResource Str_Btn_Apply}" Click="OnApplyGlassTintClicked" Style="{StaticResource AccentBtnStyle}" Margin="6,0,4,0"/>
                                            <Button Content="{DynamicResource Str_Btn_Reset}" Click="OnResetGlassTintClicked" Style="{StaticResource SubtleBtnStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Color / Accent Section (Exact MusicBar Pattern) -->
                            <TextBlock Text="{DynamicResource Str_App_ColorGroup}" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource GeoWindows}" Width="16" Height="16" Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str_App_WinAccentTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="WindowsAccentHintText" Text="{DynamicResource Str_App_WinAccentDesc}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="UseWindowsAccentCheckBox" Grid.Column="2" Style="{StaticResource FluentToggleSwitchStyle}" Checked="OnUseWindowsAccentChanged" Unchecked="OnUseWindowsAccentChanged"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource GeoLayout}" Width="16" Height="16" Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str_App_BorderAccentTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource Str_App_BorderAccentDesc}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="AccentOnBorderCheckBox" Grid.Column="2" Style="{StaticResource FluentToggleSwitchStyle}" Checked="OnAccentOnBorderChanged" Unchecked="OnAccentOnBorderChanged"/>
                                </Grid>
                            </Border>

                            <Border x:Name="AccentPalettePanel" Style="{StaticResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource GeoPalette}" Width="18" Height="18" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{DynamicResource Str_App_CustomColorTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource Str_App_CustomColorDesc}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <WrapPanel x:Name="AccentChipsWrapPanel" Grid.Column="2" VerticalAlignment="Center">
                                        <Button Tag="#FF6B6B" Click="OnPresetAccentClicked" Style="{StaticResource AccentChipStyle}" Background="#FF6B6B"/>
                                        <Button Tag="#F43F5E" Click="OnPresetAccentClicked" Style="{StaticResource AccentChipStyle}" Background="#F43F5E"/>
                                        <Button Tag="#EC4899" Click="OnPresetAccentClicked" Style="{StaticResource AccentChipStyle}" Background="#EC4899"/>
                                        <Button Tag="#A855F7" Click="OnPresetAccentClicked" Style="{StaticResource AccentChipStyle}" Background="#A855F7"/>
                                        <Button Tag="#38BDF8" Click="OnPresetAccentClicked" Style="{StaticResource AccentChipStyle}" Background="#38BDF8"/>
                                        <Button Tag="#0078D4" Click="OnPresetAccentClicked" Style="{StaticResource AccentChipStyle}" Background="#0078D4"/>
                                        <Button Tag="#14B8A6" Click="OnPresetAccentClicked" Style="{StaticResource AccentChipStyle}" Background="#14B8A6"/>
                                        <Button Tag="#10B981" Click="OnPresetAccentClicked" Style="{StaticResource AccentChipStyle}" Background="#10B981"/>
                                        <Button Tag="#84CC16" Click="OnPresetAccentClicked" Style="{StaticResource AccentChipStyle}" Background="#84CC16"/>
                                        <Button Tag="#F59E0B" Click="OnPresetAccentClicked" Style="{StaticResource AccentChipStyle}" Background="#F59E0B"/>
                                        <Button Tag="#E95420" Click="OnPresetAccentClicked" Style="{StaticResource AccentChipStyle}" Background="#E95420"/>
                                    </WrapPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="AccentColorPreviewSwatch" Width="22" Height="22" CornerRadius="11" Background="#0078D4" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="6,0,6,0"/>
                                        <TextBox x:Name="CustomAccentTextBox" Width="82" Padding="8,5" FontSize="12" Background="{DynamicResource SearchBarBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource SearchBarBorderBrush}" BorderThickness="1" TextChanged="OnCustomAccentTextChanged"/>
                                        <Button Content="{DynamicResource Str_Btn_Apply}" Click="OnApplyAccentClicked" Style="{StaticResource SubtleBtnStyle}" Margin="6,0,4,0"/>
                                        <Button Content="{DynamicResource Str_Btn_Reset}" Click="OnResetAccentClicked" Style="{StaticResource SubtleBtnStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ==================== TAB 2: WINDOW SIZE, POSITION & DISPLAY ==================== -->
                        <StackPanel x:Name="PanelWindow" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Str_Win_Header}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Str_Win_Sub}" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,14"/>

                            <TextBlock Text="{DynamicResource Str_Win_SizeGroup}" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="58"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource GeoWindowSize}" Width="18" Height="18" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str_Win_WidthTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource Str_Win_WidthDesc}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <Slider x:Name="LauncherWidthSlider" Grid.Column="2" Minimum="560" Maximum="1120" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="12,0" Style="{StaticResource ModernSliderStyle}" ValueChanged="OnLauncherSizeSliderChanged"/>
                                    <TextBlock x:Name="LauncherWidthText" Grid.Column="3" Text="780 px" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="58"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource GeoWindowSize}" Width="18" Height="18" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str_Win_HeightTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource Str_Win_HeightDesc}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <Slider x:Name="LauncherHeightSlider" Grid.Column="2" Minimum="380" Maximum="820" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="12,0" Style="{StaticResource ModernSliderStyle}" ValueChanged="OnLauncherSizeSliderChanged"/>
                                    <TextBlock x:Name="LauncherHeightText" Grid.Column="3" Text="550 px" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str_Win_SizePresetTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource Str_Win_SizePresetDesc}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Tag="640x460" Content="Compact (640×460)" Click="OnSizePresetClicked" Style="{StaticResource SubtleBtnStyle}" Margin="0,0,6,0"/>
                                        <Button Tag="780x550" Content="Standard (780×550)" Click="OnSizePresetClicked" Style="{StaticResource SubtleBtnStyle}" Margin="0,0,6,0"/>
                                        <Button Tag="960x640" Content="Wide (960×640)" Click="OnSizePresetClicked" Style="{StaticResource SubtleBtnStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="{DynamicResource Str_Win_PosGroup}" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Style="{StaticResource SettingCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str_Win_MovePresetTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{DynamicResource Str_Win_MovePresetDesc}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="SavedPositionStatusText" Text="" FontSize="11.5" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="ResetPositionSettingsBtn" Grid.Column="1" Content="{DynamicResource Str_Btn_Reset}" Click="OnResetPositionSettingsClicked" Style="{StaticResource SubtleBtnStyle}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Tag="TopCenter" Content="Top Center (Mặc định)" Click="OnWindowPositionPresetClicked" Style="{StaticResource SubtleBtnStyle}" Margin="0,0,8,6"/>
                                        <Button Tag="Center" Content="Giữa màn hình (Center)" Click="OnWindowPositionPresetClicked" Style="{StaticResource SubtleBtnStyle}" Margin="0,0,8,6"/>
                                        <Button Tag="TopLeft" Content="Góc Trên Trái" Click="OnWindowPositionPresetClicked" Style="{StaticResource SubtleBtnStyle}" Margin="0,0,8,6"/>
                                        <Button Tag="TopRight" Content="Góc Trên Phải" Click="OnWindowPositionPresetClicked" Style="{StaticResource SubtleBtnStyle}" Margin="0,0,8,6"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{DynamicResource Str_Win_MonitorGroup}" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Style="{StaticResource SettingCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Hiển thị Launcher trên màn hình nào:" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Grid>
                                    <WrapPanel Margin="0,0,0,10">
                                        <RadioButton x:Name="MonitorModeCursorRadio" GroupName="MonitorTargetGroup" Content="Màn hình có con trỏ" Checked="OnMonitorModeSelectionChanged" Style="{StaticResource ThemeCardRadioStyle}"/>
                                        <RadioButton x:Name="MonitorModePrimaryRadio" GroupName="MonitorTargetGroup" Content="Màn hình chính" Checked="OnMonitorModeSelectionChanged" Style="{StaticResource ThemeCardRadioStyle}"/>
                                        <RadioButton x:Name="MonitorModeActiveWinRadio" GroupName="MonitorTargetGroup" Content="Ứng dụng đang mở" Checked="OnMonitorModeSelectionChanged" Style="{StaticResource ThemeCardRadioStyle}"/>
                                        <RadioButton x:Name="MonitorModeSpecificRadio" GroupName="MonitorTargetGroup" Content="Chọn cố định" Checked="OnMonitorModeSelectionChanged" Style="{StaticResource ThemeCardRadioStyle}"/>
                                    </WrapPanel>

                                    <StackPanel x:Name="SpecificMonitorPanel" Visibility="Collapsed" Margin="0,0,0,10">
                                        <ComboBox x:Name="SpecificMonitorCombo" Height="34" SelectionChanged="OnSpecificMonitorChanged"/>
                                    </StackPanel>

                                    <WrapPanel Margin="0,0,0,12">
                                        <RadioButton x:Name="PositionTopCenterRadio" GroupName="WindowPosGroup" Content="Gần phía trên (28%)" Checked="OnWindowPositionChanged" Style="{StaticResource ThemeCardRadioStyle}"/>
                                        <RadioButton x:Name="PositionCenterRadio" GroupName="WindowPosGroup" Content="Chính giữa (50%)" Checked="OnWindowPositionChanged" Style="{StaticResource ThemeCardRadioStyle}"/>
                                    </WrapPanel>

                                    <Grid Margin="0,4,0,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Str_Win_MonitorsDetected}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Border Background="{DynamicResource BadgeBgBrush}" BorderBrush="{DynamicResource BadgeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="8,0,0,0">
                                                <TextBlock x:Name="MonitorsCountBadge" Text="1" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BadgeForegroundBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <Button HorizontalAlignment="Right" Content="{DynamicResource Str_Btn_Refresh}" Click="OnRefreshMonitorsClicked" Style="{StaticResource SubtleBtnStyle}"/>
                                    </Grid>
                                    <StackPanel x:Name="MonitorsCardsContainer"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ==================== TAB 3: APPS & BACKGROUND PROCESSES ==================== -->
                        <StackPanel x:Name="PanelApps" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Str_Apps_Header}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Str_Apps_Sub}" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,14"/>

                            <TextBlock Text="{DynamicResource Str_Apps_BehaviorGroup}" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource GeoTray}" Width="18" Height="18" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str_Apps_TrayTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource Str_Apps_TrayDesc}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ShowTrayIconCheckBox" Grid.Column="2" Style="{StaticResource FluentToggleSwitchStyle}" Checked="OnAppBehaviorToggleChanged" Unchecked="OnAppBehaviorToggleChanged"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource GeoMinimize}" Width="16" Height="16" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.8" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str_Apps_MinToTrayTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource Str_Apps_MinToTrayDesc}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="MinimizeToTrayCheckBox" Grid.Column="2" Style="{StaticResource FluentToggleSwitchStyle}" Checked="OnAppBehaviorToggleChanged" Unchecked="OnAppBehaviorToggleChanged"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource GeoMonitor}" Width="17" Height="17" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str_Apps_DeactivateTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource Str_Apps_DeactivateDesc}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="HideOnDeactivateCheckBox" Grid.Column="2" Style="{StaticResource FluentToggleSwitchStyle}" Checked="OnAppBehaviorToggleChanged" Unchecked="OnAppBehaviorToggleChanged"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource GeoSearch}" Width="17" Height="17" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.6" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str_Apps_RememberTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource Str_Apps_RememberDesc}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="RememberLastQueryCheckBox" Grid.Column="2" Style="{StaticResource FluentToggleSwitchStyle}" Checked="OnAppBehaviorToggleChanged" Unchecked="OnAppBehaviorToggleChanged"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource GeoLayout}" Width="17" Height="17" Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str_Apps_QuickStripTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource Str_Apps_QuickStripDesc}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ShowQuickStripCheckBox" Grid.Column="2" Style="{StaticResource FluentToggleSwitchStyle}" Checked="OnAppBehaviorToggleChanged" Unchecked="OnAppBehaviorToggleChanged"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="{DynamicResource Str_Apps_IndexGroup}" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str_Apps_IndexTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock x:Name="IndexedAppsCountText" Text="Ứng dụng đã lưu: --" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,16,0"/>
                                            <TextBlock x:Name="IndexedFilesCountText" Text="Tệp tin đã lưu: --" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="ReindexAppsButton" Content="{DynamicResource Str_Apps_ReindexApps}" Click="OnReindexAppsClicked" Style="{StaticResource SubtleBtnStyle}" Margin="0,0,8,0"/>
                                        <Button x:Name="ReindexFilesButton" Content="{DynamicResource Str_Apps_ReindexFiles}" Click="OnReindexFilesClicked" Style="{StaticResource AccentBtnStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="{DynamicResource Str_Apps_ProcGroup}" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Style="{StaticResource SettingCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str_Apps_ProcSub}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock x:Name="ProcessSummaryText" Text="Đang tải danh sách tiến trình..." FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{DynamicResource Str_Btn_Refresh}" Click="OnRefreshProcessesClicked" Style="{StaticResource SubtleBtnStyle}"/>
                                    </Grid>

                                    <TextBox x:Name="ProcessFilterTextBox"
                                             Padding="10,7"
                                             FontSize="12.5"
                                             Background="{DynamicResource SearchBarBgBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderBrush="{DynamicResource SearchBarBorderBrush}"
                                             BorderThickness="1"
                                             Margin="0,0,0,10"
                                             ToolTip="Lọc tên tiến trình hoặc PID"
                                             TextChanged="OnProcessFilterChanged"/>

                                    <ListBox x:Name="ProcessesListBox"
                                             Height="280"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,2"/>
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border Background="{DynamicResource SearchBarBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,8">
                                                                <ContentPresenter/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding CriticalTag}" FontSize="10.5" FontWeight="SemiBold" Foreground="#F59E0B" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{DynamicResource BadgeBgBrush}" BorderBrush="{DynamicResource BadgeBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding MemoryText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BadgeForegroundBrush}"/>
                                                    </Border>
                                                    <Button Grid.Column="2" Content="Dừng / End" Tag="{Binding}" Click="OnKillProcessClicked" Style="{StaticResource SubtleBtnStyle}" Padding="9,4" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ==================== TAB 4: WINDOWS SYSTEM CONTROLS ==================== -->
                        <StackPanel x:Name="PanelSystem" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Str_Sys_Header}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Str_Sys_Sub}" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,14"/>

                            <!-- Windows Theme Mode -->
                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource GeoMoon}" Width="18" Height="18" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Windows Dark / Light Mode" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="WindowsThemeModeStatusText" Text="Hiện tại: --" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Tối (Dark)" Click="OnSetWindowsDarkModeClicked" Style="{StaticResource SubtleBtnStyle}" Margin="0,0,6,0"/>
                                        <Button Content="Sáng (Light)" Click="OnSetWindowsLightModeClicked" Style="{StaticResource SubtleBtnStyle}" Margin="0,0,6,0"/>
                                        <Button Content="Đổi" Click="OnToggleWindowsDarkModeClicked" Style="{StaticResource AccentBtnStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Wi-Fi Direct In-App Controls -->
                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource GeoWifi}" Width="18" Height="18" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Wi-Fi (Mạng không dây)" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="WindowsWifiStatusText" Text="Đang kiểm tra..." FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Bật / Tắt" Click="OnToggleWifiClicked" Style="{StaticResource AccentBtnStyle}" Margin="0,0,6,0"/>
                                        <Button Content="Danh sách Wi-Fi" Click="OnShowWifiListClicked" Style="{StaticResource SubtleBtnStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Bluetooth Direct In-App Controls -->
                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource GeoBluetooth}" Width="18" Height="18" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Bluetooth &amp; Thiết bị" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="WindowsBluetoothStatusText" Text="Đang kiểm tra..." FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Bật / Tắt" Click="OnToggleBluetoothClicked" Style="{StaticResource AccentBtnStyle}" Margin="0,0,6,0"/>
                                        <Button Content="Danh sách thiết bị" Click="OnShowBluetoothListClicked" Style="{StaticResource SubtleBtnStyle}" Margin="0,0,6,0"/>
                                        <Button Content="+ Ghép đôi" Click="OnAddBluetoothDeviceClicked" Style="{StaticResource SubtleBtnStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Battery Saver In-App Controls -->
                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource GeoBattery}" Width="18" Height="18" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Tiết kiệm pin (Energy Saver)" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="WindowsBatterySaverStatusText" Text="Đang kiểm tra..." FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Bật / Tắt" Click="OnToggleBatterySaverClicked" Style="{StaticResource AccentBtnStyle}" Margin="0,0,6,0"/>
                                        <Button Content="Bật" Click="OnEnableBatterySaverClicked" Style="{StaticResource SubtleBtnStyle}" Margin="0,0,4,0"/>
                                        <Button Content="Tắt" Click="OnDisableBatterySaverClicked" Style="{StaticResource SubtleBtnStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Audio Volume -->
                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource GeoVolume}" Width="18" Height="18" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Âm lượng (Volume)" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="WindowsVolumeValueText" Text="50%" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                    <Slider x:Name="WindowsVolumeSlider" Grid.Column="2" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="10,0" Style="{StaticResource ModernSliderStyle}" ValueChanged="OnWindowsVolumeSliderChanged"/>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="WindowsMuteButton" Content="Mute" Click="OnWindowsToggleMuteClicked" Style="{StaticResource SubtleBtnStyle}" Margin="0,0,4,0"/>
                                        <Button Content="Mixer" Click="OnOpenVolumeMixerClicked" Style="{StaticResource SubtleBtnStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Screen Brightness -->
                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource GeoBrightness}" Width="18" Height="18" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Độ sáng màn hình" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="WindowsBrightnessValueText" Text="70%" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                    <Slider x:Name="WindowsBrightnessSlider" Grid.Column="2" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="10,0" Style="{StaticResource ModernSliderStyle}" ValueChanged="OnWindowsBrightnessSliderChanged"/>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="25%" Click="OnSetBrightness25Clicked" Style="{StaticResource SubtleBtnStyle}" Margin="0,0,4,0"/>
                                        <Button Content="50%" Click="OnSetBrightness50Clicked" Style="{StaticResource SubtleBtnStyle}" Margin="0,0,4,0"/>
                                        <Button Content="100%" Click="OnSetBrightness100Clicked" Style="{StaticResource SubtleBtnStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Hotspot & Taskbar -->
                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Mobile Hotspot &amp; Taskbar" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Phát Wi-Fi di động hoặc căn chỉnh vị trí thanh Taskbar Windows" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Hotspot Bật/Tắt" Click="OnToggleHotspotClicked" Style="{StaticResource SubtleBtnStyle}" Margin="0,0,6,0"/>
                                        <Button Content="Taskbar: Giữa" Click="OnSetTaskbarAlignCenterClicked" Style="{StaticResource SubtleBtnStyle}" Margin="0,0,4,0"/>
                                        <Button Content="Taskbar: Trái" Click="OnSetTaskbarAlignLeftClicked" Style="{StaticResource SubtleBtnStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ==================== TAB 5: LOCAL AI ==================== -->
                        <StackPanel x:Name="PanelAI" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Str_AI_Header}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Str_AI_Sub}" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,14"/>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Máy chủ Ollama cục bộ (API Endpoint)" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border x:Name="OllamaStatusBorder" HorizontalAlignment="Right" Background="#2264748B" BorderBrush="#4464748B" BorderThickness="1" CornerRadius="6" Padding="8,2">
                                            <TextBlock x:Name="OllamaStatusText" Text="Chưa kiểm tra" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Border>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="OllamaEndpointTextBox" Grid.Column="0" Text="http://localhost:11434" Padding="10,7" Background="{DynamicResource SearchBarBgBrush}" BorderBrush="{DynamicResource SearchBarBorderBrush}" BorderThickness="1" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Button x:Name="StartOllamaButton" Grid.Column="1" Content="▶ Khởi chạy" Click="OnStartOllamaClicked" Style="{StaticResource SubtleBtnStyle}" Margin="8,0,0,0"/>
                                        <Button x:Name="TestOllamaButton" Grid.Column="2" Content="Kiểm tra" Click="OnTestOllamaClicked" Style="{StaticResource AccentBtnStyle}" Margin="6,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Mô hình mặc định (Default Model)" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Chọn mô hình LLM đã tải về trong Ollama" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="OllamaModelComboBox" Grid.Column="1" IsEditable="True" Height="34" Margin="8,0"/>
                                    <Button x:Name="RefreshModelsButton" Grid.Column="2" Content="{DynamicResource Str_Btn_Refresh}" Click="OnRefreshModelsClicked" Style="{StaticResource SubtleBtnStyle}"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Tự động khởi chạy Ollama khi mở LAILauncher" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Sẵn sàng trả lời AI ngay mà không cần mở terminal Ollama riêng" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="StartOllamaWithAppCheckBox" Grid.Column="1" Style="{StaticResource FluentToggleSwitchStyle}"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Phân loại ý định ngữ nghĩa (Zero-NPU Intent Classifier)" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Hiểu truy vấn tự nhiên bằng ONNX tốc độ dưới 5ms hoàn toàn offline" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="EnableIntentClassifierCheckBox" Grid.Column="1" Style="{StaticResource FluentToggleSwitchStyle}"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ==================== TAB 6: ABOUT ==================== -->
                        <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Str_About_Header}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Str_About_Sub}" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,14"/>

                            <!-- Brand Hero Card -->
                            <Border Style="{StaticResource SettingCardStyle}" Padding="20,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="pack://application:,,,/Assets/app-logo.png" Width="60" Height="60" Margin="0,0,18,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Str_AppName}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Border Background="{DynamicResource BadgeBgBrush}" BorderBrush="{DynamicResource BadgeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="v2.4.0 Pro" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource Str_About_HeroDesc}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="{DynamicResource Str_About_EnvGroup}" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Style="{StaticResource SettingCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Phiên bản ứng dụng / App Version" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="AboutAppVersionText" Text="2.4.0" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Separator Background="{DynamicResource SeparatorBrush}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Runtime / Framework" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="AboutRuntimeText" Text=".NET 8 Windows WPF" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Separator Background="{DynamicResource SeparatorBrush}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Hệ điều hành / OS Build" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="AboutOsVersionText" Text="Windows 11" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Separator Background="{DynamicResource SeparatorBrush}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <TextBlock Text="Thư mục dữ liệu / Data Folder" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="AboutDataPathText" Text="%AppData%\LAILauncher" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{DynamicResource Str_About_TechGroup}" Style="{StaticResource SectionTitleStyle}"/>
                            <Border Style="{StaticResource SettingCardStyle}">
                                <WrapPanel>
                                    <Border Background="{DynamicResource BadgeBgBrush}" BorderBrush="{DynamicResource BadgeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,8,6">
                                        <TextBlock Text=".NET 8 + WPF Fluent" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BadgeForegroundBrush}"/>
                                    </Border>
                                    <Border Background="{DynamicResource BadgeBgBrush}" BorderBrush="{DynamicResource BadgeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,8,6">
                                        <TextBlock Text="ONNX Semantic Classifier" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BadgeForegroundBrush}"/>
                                    </Border>
                                    <Border Background="{DynamicResource BadgeBgBrush}" BorderBrush="{DynamicResource BadgeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,8,6">
                                        <TextBlock Text="Win32 Native WLAN &amp; Bluetooth" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BadgeForegroundBrush}"/>
                                    </Border>
                                    <Border Background="{DynamicResource BadgeBgBrush}" BorderBrush="{DynamicResource BadgeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,8,6">
                                        <TextBlock Text="SQLite FTS5 Offline Index" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BadgeForegroundBrush}"/>
                                    </Border>
                                    <Border Background="{DynamicResource BadgeBgBrush}" BorderBrush="{DynamicResource BadgeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,8,6">
                                        <TextBlock Text="Ollama Local LLM" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BadgeForegroundBrush}"/>
                                    </Border>
                                </WrapPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str_About_LicenseTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource Str_About_LicenseDesc}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Str_About_ActionsTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="{DynamicResource Str_About_OpenData}" Click="OnOpenAppDataClicked" Style="{StaticResource SubtleBtnStyle}" Margin="0,0,6,0"/>
                                        <Button Content="{DynamicResource Str_About_CopyDiag}" Click="OnCopyDiagnosticsClicked" Style="{StaticResource SubtleBtnStyle}" Margin="0,0,6,0"/>
                                        <Button Content="{DynamicResource Str_About_ResetDefaults}" Click="OnResetAllDefaultsClicked" Style="{StaticResource SubtleBtnStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
