                                            Visibility="Collapsed" 
                                            Background="{DynamicResource SearchBarBgBrush}" 
                                            BorderBrush="{DynamicResource AccentBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="8" 
                                            Padding="12,10" 
                                            Margin="0,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="Chọn màn hình cụ thể muốn cố định Launcher:" 
                                                       FontSize="11" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                                       Margin="0,0,0,6"/>
                                            <ComboBox x:Name="SpecificMonitorCombo" 
                                                      Height="34" 
                                                      SelectionChanged="OnSpecificMonitorChanged"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- SECTION: VỊ TRÍ DỌC TRÊN MÀN HÌNH (VERTICAL ALIGNMENT) -->
                            <Border Background="{DynamicResource CardBgBrush}" 
                                    BorderBrush="{DynamicResource CardBorderBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="12" 
                                    Padding="16"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="📐 Vị Trí Dọc Trên Màn Hình (Vertical Alignment)" 
                                               FontSize="12" 
                                               FontWeight="Bold" 
                                               Foreground="{DynamicResource AccentBrush}" 
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="Cân chỉnh độ cao xuất hiện của cửa sổ tìm kiếm trên không gian màn hình:" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource TextSecondaryBrush}" 
                                               Margin="0,0,0,12"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Top-Center (Raycast Style) -->
                                        <RadioButton Grid.Column="0" 
                                                     x:Name="PositionTopCenterRadio" 
                                                     GroupName="WindowPosGroup" 
                                                     Style="{StaticResource ThemeCardRadioStyle}" 
                                                     Checked="OnWindowPositionChanged">
                                            <StackPanel Margin="6,4">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="⬆️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Phía trên giữa (Raycast Style)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Mặc định" FontSize="8.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="Cách mép trên ~25% màn hình, vừa tầm mắt nhìn, không che nội dung trung tâm" 
                                                           FontSize="10" 
                                                           Foreground="{DynamicResource TextMutedBrush}" 
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </RadioButton>

                                        <!-- True Center -->
                                        <RadioButton Grid.Column="2" 
                                                     x:Name="PositionCenterRadio" 
                                                     GroupName="WindowPosGroup" 
                                                     Style="{StaticResource ThemeCardRadioStyle}" 
                                                     Checked="OnWindowPositionChanged">
                                            <StackPanel Margin="6,4">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="↕️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Chính giữa màn hình (Center)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="Nằm ngay chính giữa trọng tâm màn hình theo cả chiều dọc và ngang" 
                                                           FontSize="10" 
                                                           Foreground="{DynamicResource TextMutedBrush}" 
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </Grid>

                                    <!-- Vị trí cửa sổ tùy chỉnh & Đặt lại trung tâm -->
                                    <Border Background="{DynamicResource BadgeBgBrush}" 
                                            BorderBrush="{DynamicResource BadgeBorderBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="8" 
                                            Padding="12,10" 
                                            Margin="0,12,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <TextBlock Text="📍" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="SavedPositionStatusText" 
                                                               Text="Vị trí cửa sổ: Mặc định (Tự động canh giữa)" 
                                                               FontSize="11" 
                                                               FontWeight="SemiBold" 
                                                               Foreground="{DynamicResource TextPrimaryBrush}" 
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="Kéo thanh tiêu đề LAILauncher để di chuyển vị trí. Vị trí sẽ tự động được lưu cho các lần sau." 
                                                           FontSize="10" 
                                                           Foreground="{DynamicResource TextMutedBrush}" 
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            
                                            <!-- Nút Reset Vị Trí Trung Tâm -->
                                            <Button Grid.Column="1" 
                                                    x:Name="ResetPositionSettingsBtn" 
                                                    Click="OnResetPositionSettingsClicked" 
                                                    Cursor="Hand" 
                                                    Margin="12,0,0,0" 
                                                    Background="{DynamicResource AccentBrush}" 
                                                    Foreground="#FFFFFF" 
                                                    BorderThickness="0" 
                                                    Padding="12,6" 
                                                    VerticalAlignment="Center">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="btnBd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Data="{StaticResource GeoReset}" Width="10.5" Height="10.5" Stroke="#FFFFFF" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Đặt lại trung tâm" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="btnBd" Property="Opacity" Value="0.9"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- SECTION: SƠ ĐỒ CÁC MÀN HÌNH ĐANG KẾT NỐI (CONNECTED DISPLAYS LIST) -->
                            <Border Background="{DynamicResource CardBgBrush}" 
                                    BorderBrush="{DynamicResource CardBorderBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="12" 
                                    Padding="16"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📊 Các Màn Hình Đang Kết Nối" 
                                                       FontSize="12" 
                                                       FontWeight="Bold" 
                                                       Foreground="{DynamicResource AccentBrush}" 
                                                       VerticalAlignment="Center"/>
                                            <Border Background="{DynamicResource ItemSelectedBgBrush}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                                                <TextBlock x:Name="MonitorsCountBadge" Text="1 màn hình" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Container where monitor cards are generated dynamically -->
                                    <StackPanel x:Name="MonitorsCardsContainer" Margin="0,4,0,0"/>

                                    <!-- Fail-safe note -->
                                    <Border Background="{DynamicResource SearchBarBgBrush}" 
                                            CornerRadius="6" 
                                            Padding="10,8" 
                                            Margin="0,10,0,0">
                                        <TextBlock Text="🛡️ Tự động an toàn (Fail-safe): Nếu màn hình đã chọn bị ngắt kết nối (rút cáp HDMI/DisplayPort), Launcher sẽ tự động xuất hiện tại màn hình chính của Windows để bạn không bao giờ bị mất giao diện." 
                                                   FontSize="10" 
                                                   Foreground="{DynamicResource TextMutedBrush}" 
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Phím tắt">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16,0,0,0">
                        <StackPanel>
                    <!-- SECTION 2: PHÍM TẮT TOÀN CỤC (GLOBAL HOTKEY) -->
                    <Border Background="{DynamicResource CardBgBrush}" 
                            BorderBrush="{DynamicResource CardBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="12" 
                            Padding="16"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Phím tắt toàn cục" 
                                       FontSize="12" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource AccentBrush}" 
                                       Margin="0,0,0,8"/>
                            
                            <TextBlock Text="Chọn phím tắt nhanh hoặc bấm vào ô để thu phím tắt mới:" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextSecondaryBrush}" 
                                       Margin="0,0,0,10"/>

                            <ComboBox x:Name="HotkeyPresetCombo" 
                                      Height="36" 
                                      SelectionChanged="OnHotkeyPresetChanged"
                                      Margin="0,0,0,10">
                                <ComboBoxItem Content="Alt + Space (Mặc định)"/>
                                <ComboBoxItem Content="Ctrl + Space"/>
                                <ComboBoxItem Content="Win + Space"/>
                                <ComboBoxItem Content="Alt + K"/>
                                <ComboBoxItem Content="Ctrl + Shift + Space"/>
                                <ComboBoxItem Content="Tùy biến..."/>
                            </ComboBox>

                            <!-- Custom Hotkey Recorder Box -->
                            <Grid x:Name="CustomHotkeyPanel" Visibility="Collapsed" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBox x:Name="CustomHotkeyBox" 
                                         Grid.Column="0" 
                                         Height="34" 
                                         VerticalContentAlignment="Center" 
                                         Padding="10,0"
                                         Background="{DynamicResource SearchBarBgBrush}" 
                                         Foreground="{DynamicResource TextPrimaryBrush}" 
                                         BorderBrush="{DynamicResource SearchBarBorderBrush}" 
                                         IsReadOnly="True"
                                         FontSize="13"
                                         FontFamily="Segoe UI"
                                         PreviewKeyDown="OnCustomHotkeyPreviewKeyDown"/>

                                <Button Grid.Column="1" 
                                        Content="Xác nhận" 
                                        Margin="8,0,0,0" 
                                        Padding="14,0" 
                                        Height="34" 
                                        Background="{DynamicResource AccentBrush}" 
                                        Foreground="#FFFFFF" 
                                        FontWeight="SemiBold" 
                                        BorderThickness="0" 
                                        Cursor="Hand"
                                        Click="OnApplyCustomHotkeyClicked">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <TextBlock x:Name="HotkeyStatusText" 
                                       Text="Phím tắt đang hoạt động: Alt + Space"
                                       FontSize="12" 
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Khởi động">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16,0,0,0">
                        <StackPanel>
                    <!-- SECTION 3: HỆ THỐNG (SYSTEM & STARTUP) -->
                    <Border Background="{DynamicResource CardBgBrush}" 
                            BorderBrush="{DynamicResource CardBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="12" 
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="Khởi động" 
                                       FontSize="12" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource AccentBrush}" 
                                       Margin="0,0,0,10"/>

                            <CheckBox x:Name="AutoStartCheckBox" 
                                      Content="Khởi chạy cùng Windows khi mở máy" 
                                      FontSize="13" 
                                      Foreground="{DynamicResource TextPrimaryBrush}" 
                                      Checked="OnAutoStartToggled" 
                                      Unchecked="OnAutoStartToggled" 
                                      Cursor="Hand"/>
                            
                            <TextBlock Text="Tự động mở launcher ở chế độ nền khi đăng nhập vào Windows." 
                                       FontSize="11" 
                                       Foreground="{DynamicResource TextMutedBrush}" 
                                       Margin="24,4,0,0"/>
                        </StackPanel>
                    </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="AI cục bộ">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16,0,0,0">
                        <StackPanel>
                    <!-- SECTION 4: AI CỤC BỘ & MÔ HÌNH (LOCAL AI & MODELS) -->
                    <Border Background="{DynamicResource CardBgBrush}" 
                            BorderBrush="{DynamicResource CardBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="12" 
                            Padding="16"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Mô hình cục bộ" 
                                       FontSize="12" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource AccentBrush}" 
                                       Margin="0,0,0,12"/>

                            <!-- Endpoint config -->
                            <TextBlock Text="Địa chỉ máy chủ Ollama (API Endpoint):" 
                                       FontSize="12" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                       Margin="0,0,0,6"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="OllamaEndpointTextBox" 
                                         Grid.Column="0" 
                                         Text="http://localhost:11434" 
                                         Background="{DynamicResource SearchBarBgBrush}" 
                                         Foreground="{DynamicResource TextPrimaryBrush}" 
                                         BorderBrush="{DynamicResource CardBorderBrush}" 
                                         BorderThickness="1" 
                                         Padding="8,6" 
                                         FontSize="12" 
                                         VerticalAlignment="Center"/>

                                <Button x:Name="TestOllamaButton" 
                                        Grid.Column="1" 
                                        Content="Kiểm tra" 
                                        Margin="8,0,0,0" 
                                        Padding="12,6" 
                                        Background="{DynamicResource SearchBarBgBrush}" 
                                        Foreground="{DynamicResource TextPrimaryBrush}" 
                                        BorderBrush="{DynamicResource CardBorderBrush}" 
                                        BorderThickness="1" 
                                        FontSize="12" 
                                        FontWeight="SemiBold" 
                                        Cursor="Hand" 
                                        Click="OnTestOllamaClicked"/>

                                    <Button x:Name="StartOllamaButton"
                                        Grid.Column="2"
                                        Content="▶ Khởi chạy"
                                        Margin="8,0,0,0"
                                        Padding="12,6"
                                        Background="{DynamicResource SearchBarBgBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"
                                        Click="OnStartOllamaClicked"/>

                                <!-- Health Status Badge -->
                                <Border x:Name="OllamaStatusBorder" 
                                        Grid.Column="3" 
                                        Background="#2264748B" 
                                        BorderBrush="#4464748B" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Padding="8,5" 
                                        Margin="8,0,0,0" 
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="OllamaStatusText" 
                                               Text="Chưa kiểm tra" 
                                               FontSize="11" 
                                               FontWeight="SemiBold" 
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </Border>
                            </Grid>

                            <!-- Model Selection -->
                            <TextBlock Text="Mô hình ngôn ngữ mặc định (LLM Model):" 
                                       FontSize="12" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                       Margin="0,4,0,6"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="OllamaModelComboBox" 
                                          Grid.Column="0" 
                                          IsEditable="True" 
                                          FontSize="12" 
                                          Background="{DynamicResource SearchBarBgBrush}" 
                                          Foreground="{DynamicResource TextPrimaryBrush}" 
                                          BorderBrush="{DynamicResource CardBorderBrush}" 
                                          Padding="6,4"/>

                                <Button x:Name="RefreshModelsButton" 
                                        Grid.Column="1" 
                                        Content="Làm mới"
                                        Margin="8,0,0,0" 
                                        Padding="10,6" 
                                        Background="{DynamicResource SearchBarBgBrush}" 
                                        Foreground="{DynamicResource TextPrimaryBrush}" 
                                        BorderBrush="{DynamicResource CardBorderBrush}" 
                                        BorderThickness="1" 
                                        FontSize="12" 
                                        FontWeight="SemiBold" 
                                        Cursor="Hand" 
                                        ToolTip="Lấy danh sách các mô hình đã cài đặt trong Ollama" 
                                        Click="OnRefreshModelsClicked"/>
                            </Grid>

                            <!-- ONNX Router Checkbox -->
                            <CheckBox x:Name="EnableIntentClassifierCheckBox" 
                                      Content="Kích hoạt mô hình ONNX Intent Classifier (AI Router)" 
                                      IsChecked="True" 
                                      FontSize="13" 
                                      Foreground="{DynamicResource TextPrimaryBrush}" 
                                      Cursor="Hand"/>

                            <TextBlock Text="Tự động nhận diện ý định tìm kiếm (APP, FILE, CALC, AI...) với mô hình ONNX siêu nhẹ (&lt; 5ms)." 
                                       FontSize="11" 
                                       Foreground="{DynamicResource TextMutedBrush}" 
                                       Margin="24,4,0,0"/>

                            <CheckBox x:Name="StartOllamaWithAppCheckBox"
                                      Content="Khởi chạy Ollama cùng LAILauncher"
                                      FontSize="13"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      Margin="0,12,0,0"
                                      Cursor="Hand"/>

                            <TextBlock Text="Tự động bật máy chủ Ollama cục bộ khi mở ứng dụng."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="24,4,0,0"/>
                        </StackPanel>
                    </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Hệ thống Windows">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16,0,0,0">
                        <StackPanel>
                            <!-- SECTION 1: DARK MODE WINDOWS & MÀU THEME -->
                            <Border Background="{DynamicResource CardBgBrush}" 
                                    BorderBrush="{DynamicResource CardBorderBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="12" 
                                    Padding="16"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Giao diện &amp; Theme Windows" 
                                               FontSize="12" 
                                               FontWeight="Bold" 
                                               Foreground="{DynamicResource AccentBrush}" 
                                               Margin="0,0,0,10"/>

                                    <!-- Dark Mode Toggle Row -->
                                    <Border Background="{DynamicResource SearchBarBgBrush}" 
                                            BorderBrush="{DynamicResource SearchBarBorderBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="8" 
                                            Padding="12,10" 
                                            Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Chế độ Sáng / Tối của hệ thống Windows:" 
                                                           FontSize="12" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock x:Name="WindowsThemeModeStatusText" 
                                                           Text="Hiện tại: Đang ở chế độ Tối (Dark Mode)" 
                                                           FontSize="11" 
                                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Chuyển Dark / Light" 
                                                        Height="30" Padding="12,0" Margin="0,0,6,0"
                                                        Background="{DynamicResource AccentBrush}" Foreground="#FFFFFF"
                                                        FontWeight="SemiBold" FontSize="11.5" BorderThickness="0" Cursor="Hand"
                                                        Click="OnToggleWindowsDarkModeClicked"/>
                                                <Button Content="🌙 Tối" 
                                                        Height="30" Padding="10,0" Margin="0,0,6,0"
                                                        Background="{DynamicResource SearchBarBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                        FontSize="11.5" Cursor="Hand"
                                                        Click="OnSetWindowsDarkModeClicked"/>
                                                <Button Content="☀️ Sáng" 
                                                        Height="30" Padding="10,0"
                                                        Background="{DynamicResource SearchBarBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                        FontSize="11.5" Cursor="Hand"
                                                        Click="OnSetWindowsLightModeClicked"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Windows Theme / Accent Color Palette -->
                                    <TextBlock Text="Đổi màu điểm nhấn (Accent Color) của hệ thống Windows:" 
                                               FontSize="11.5" 
                                               FontWeight="SemiBold" 
                                               Foreground="{DynamicResource TextPrimaryBrush}" 
                                               Margin="0,0,0,8"/>
                                    <WrapPanel Margin="0,0,0,4">
                                        <Button Style="{StaticResource AccentChipStyle}" Background="#0078D7" ToolTip="Electric Blue" Click="OnWindowsAccentChipClicked" Tag="#0078D7"/>
                                        <Button Style="{StaticResource AccentChipStyle}" Background="#744DA9" ToolTip="Royal Purple" Click="OnWindowsAccentChipClicked" Tag="#744DA9"/>
                                        <Button Style="{StaticResource AccentChipStyle}" Background="#E81123" ToolTip="Crimson Red" Click="OnWindowsAccentChipClicked" Tag="#E81123"/>
                                        <Button Style="{StaticResource AccentChipStyle}" Background="#107C41" ToolTip="Emerald Green" Click="OnWindowsAccentChipClicked" Tag="#107C41"/>
                                        <Button Style="{StaticResource AccentChipStyle}" Background="#CA5010" ToolTip="Amber Orange" Click="OnWindowsAccentChipClicked" Tag="#CA5010"/>
                                        <Button Style="{StaticResource AccentChipStyle}" Background="#008272" ToolTip="Vivid Turquoise" Click="OnWindowsAccentChipClicked" Tag="#008272"/>
                                        <Button Style="{StaticResource AccentChipStyle}" Background="#E3008C" ToolTip="Magenta Pink" Click="OnWindowsAccentChipClicked" Tag="#E3008C"/>
                                        <Button Style="{StaticResource AccentChipStyle}" Background="#2D3748" ToolTip="Slate Charcoal" Click="OnWindowsAccentChipClicked" Tag="#2D3748"/>
                                        <Button Content="Cài đặt Màu Windows ↗" 
                                                Height="26" Padding="8,0" Margin="6,0,0,6"
                                                Background="Transparent" Foreground="{DynamicResource AccentBrush}"
                                                FontSize="11" BorderThickness="0" Cursor="Hand"
                                                Click="OnOpenWindowsColorSettingsClicked"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 2: ÂM LƯỢNG & ĐỘ SÁNG MÀN HÌNH -->
                            <Border Background="{DynamicResource CardBgBrush}" 
                                    BorderBrush="{DynamicResource CardBorderBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="12" 
                                    Padding="16"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Âm lượng &amp; Màn hình" 
                                               FontSize="12" 
                                               FontWeight="Bold" 
                                               Foreground="{DynamicResource AccentBrush}" 
                                               Margin="0,0,0,10"/>

                                    <!-- Master Volume Slider -->
                                    <Border Background="{DynamicResource SearchBarBgBrush}" 
                                            BorderBrush="{DynamicResource SearchBarBorderBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="8" 
                                            Padding="12,10" 
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="🔊 Âm lượng hệ thống:" 
                                                           FontSize="11.5" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock x:Name="WindowsVolumeValueText" 
                                                           Text="50%" 
                                                           FontSize="12" 
                                                           FontWeight="Bold" 
                                                           Foreground="{DynamicResource AccentBrush}" 
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="WindowsVolumeSlider" 
                                                    Style="{StaticResource ModernSliderStyle}" 
                                                    Minimum="0" Maximum="100" Value="50" 
                                                    SmallChange="2" LargeChange="10" 
                                                    ValueChanged="OnWindowsVolumeSliderChanged"/>
                                            <Grid Margin="0,8,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="WindowsMuteButton" Content="🔇 Mute" 
                                                            Height="28" Padding="10,0" Margin="0,0,6,0"
                                                            Background="{DynamicResource SearchBarBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                            FontSize="11" Cursor="Hand"
                                                            Click="OnWindowsToggleMuteClicked"/>
                                                    <Button Content="-5%" 
                                                            Height="28" Padding="8,0" Margin="0,0,6,0"
                                                            Background="{DynamicResource SearchBarBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                            FontSize="11" Cursor="Hand"
                                                            Click="OnWindowsVolumeDownClicked"/>
                                                    <Button Content="+5%" 
                                                            Height="28" Padding="8,0" Margin="0,0,6,0"
                                                            Background="{DynamicResource SearchBarBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                            FontSize="11" Cursor="Hand"
                                                            Click="OnWindowsVolumeUpClicked"/>
                                                </StackPanel>
                                                <Button Content="Bộ trộn Volume Mixer ↗" 
                                                        HorizontalAlignment="Right"
                                                        Height="28" Padding="10,0"
                                                        Background="Transparent" Foreground="{DynamicResource AccentBrush}"
                                                        FontSize="11" BorderThickness="0" Cursor="Hand"
                                                        Click="OnOpenVolumeMixerClicked"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Screen Brightness Slider -->
                                    <Border Background="{DynamicResource SearchBarBgBrush}" 
                                            BorderBrush="{DynamicResource SearchBarBorderBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="8" 
                                            Padding="12,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="🔆 Độ sáng màn hình:" 
                                                           FontSize="11.5" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock x:Name="WindowsBrightnessValueText" 
                                                           Text="70%" 
                                                           FontSize="12" 
                                                           FontWeight="Bold" 
                                                           Foreground="{DynamicResource AccentBrush}" 
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="WindowsBrightnessSlider" 
                                                    Style="{StaticResource ModernSliderStyle}" 
                                                    Minimum="0" Maximum="100" Value="70" 
                                                    SmallChange="5" LargeChange="10" 
                                                    ValueChanged="OnWindowsBrightnessSliderChanged"/>
                                            <Grid Margin="0,8,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="-10%" 
                                                            Height="28" Padding="8,0" Margin="0,0,6,0"
                                                            Background="{DynamicResource SearchBarBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                            FontSize="11" Cursor="Hand"
                                                            Click="OnWindowsBrightnessDownClicked"/>
                                                    <Button Content="+10%" 
                                                            Height="28" Padding="8,0" Margin="0,0,6,0"
                                                            Background="{DynamicResource SearchBarBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                            FontSize="11" Cursor="Hand"
                                                            Click="OnWindowsBrightnessUpClicked"/>
                                                    <Button Content="25%" 
                                                            Height="28" Padding="8,0" Margin="0,0,6,0"
                                                            Background="{DynamicResource SearchBarBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                            FontSize="11" Cursor="Hand"
                                                            Click="OnSetBrightness25Clicked"/>
                                                    <Button Content="50%" 
                                                            Height="28" Padding="8,0" Margin="0,0,6,0"
                                                            Background="{DynamicResource SearchBarBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                            FontSize="11" Cursor="Hand"
                                                            Click="OnSetBrightness50Clicked"/>
                                                    <Button Content="100%" 
                                                            Height="28" Padding="8,0"
                                                            Background="{DynamicResource SearchBarBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                            FontSize="11" Cursor="Hand"
                                                            Click="OnSetBrightness100Clicked"/>
                                                </StackPanel>
                                                <Button Content="Cài đặt Display ↗" 
                                                        HorizontalAlignment="Right"
                                                        Height="28" Padding="10,0"
                                                        Background="Transparent" Foreground="{DynamicResource AccentBrush}"
                                                        FontSize="11" BorderThickness="0" Cursor="Hand"
                                                        Click="OnOpenDisplaySettingsClicked"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 3: MẠNG, KẾT NỐI & TIẾT KIỆM PIN -->
                            <Border Background="{DynamicResource CardBgBrush}" 
                                    BorderBrush="{DynamicResource CardBorderBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="12" 
                                    Padding="16"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Mạng, Bluetooth &amp; Năng lượng" 
                                               FontSize="12" 
                                               FontWeight="Bold" 
                                               Foreground="{DynamicResource AccentBrush}" 
                                               Margin="0,0,0,10"/>

                                    <!-- Wi-Fi Controls -->
                                    <Border Background="{DynamicResource SearchBarBgBrush}" 
                                            BorderBrush="{DynamicResource SearchBarBorderBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="8" 
                                            Padding="12,10" 
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Mạng không dây (Wi-Fi):" 
                                                           FontSize="11.5" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Xem danh sách mạng khả dụng hoặc bật/tắt kết nối" 
                                                           FontSize="11" 
                                                           Foreground="{DynamicResource TextMutedBrush}" 
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="📡 Danh sách Wi-Fi" 
                                                        Height="30" Padding="12,0" Margin="0,0,6,0"
                                                        Background="{DynamicResource AccentBrush}" Foreground="#FFFFFF"
                                                        FontWeight="SemiBold" FontSize="11.5" BorderThickness="0" Cursor="Hand"
                                                        Click="OnShowWifiListClicked"/>
                                                <Button Content="Bật Wi-Fi" 
                                                        Height="30" Padding="10,0" Margin="0,0,6,0"
                                                        Background="{DynamicResource SearchBarBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                        FontSize="11" Cursor="Hand"
                                                        Click="OnTurnOnWifiClicked"/>
                                                <Button Content="Tắt Wi-Fi" 
                                                        Height="30" Padding="10,0"
                                                        Background="{DynamicResource SearchBarBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                        FontSize="11" Cursor="Hand"
                                                        Click="OnTurnOffWifiClicked"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Bluetooth & Mobile Hotspot Row -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Bluetooth Box -->
                                        <Border Grid.Column="0" 
                                                Background="{DynamicResource SearchBarBgBrush}" 
                                                BorderBrush="{DynamicResource SearchBarBorderBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="8" 
                                                Padding="12,10" 
                                                Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="📶 Bluetooth &amp; Thiết bị:" 
                                                           FontSize="11.5" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource TextPrimaryBrush}" 
                                                           Margin="0,0,0,6"/>
                                                <WrapPanel>
                                                    <Button Content="Cài đặt Bluetooth" 
                                                            Height="28" Padding="10,0" Margin="0,0,6,6"
                                                            Background="{DynamicResource SearchBarBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                            FontSize="11" Cursor="Hand"
                                                            Click="OnOpenBluetoothClicked"/>
                                                    <Button Content="➕ Thêm thiết bị" 
                                                            Height="28" Padding="10,0" Margin="0,0,6,6"
                                                            Background="{DynamicResource SearchBarBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                            FontSize="11" Cursor="Hand"
                                                            Click="OnAddBluetoothDeviceClicked"/>
                                                    <Button Content="Bật/Tắt Bluetooth" 
                                                            Height="28" Padding="10,0" Margin="0,0,0,6"
                                                            Background="{DynamicResource SearchBarBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                            FontSize="11" Cursor="Hand"
                                                            Click="OnToggleBluetoothClicked"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Hotspot Box -->
                                        <Border Grid.Column="1" 
                                                Background="{DynamicResource SearchBarBgBrush}" 
                                                BorderBrush="{DynamicResource SearchBarBorderBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="8" 
                                                Padding="12,10" 
                                                Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="📱 Mobile Hotspot:" 
                                                           FontSize="11.5" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource TextPrimaryBrush}" 
                                                           Margin="0,0,0,6"/>
                                                <WrapPanel>
                                                    <Button Content="Cài đặt Hotspot" 
                                                            Height="28" Padding="10,0" Margin="0,0,6,6"
                                                            Background="{DynamicResource SearchBarBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                            FontSize="11" Cursor="Hand"
                                                            Click="OnOpenHotspotSettingsClicked"/>
                                                    <Button Content="Bật/Tắt Hotspot" 
                                                            Height="28" Padding="10,0" Margin="0,0,0,6"
                                                            Background="{DynamicResource SearchBarBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                            FontSize="11" Cursor="Hand"
                                                            Click="OnToggleHotspotClicked"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Battery Saver Row -->
                                    <Border Background="{DynamicResource SearchBarBgBrush}" 
                                            BorderBrush="{DynamicResource SearchBarBorderBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="8" 
                                            Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Tiết kiệm pin (Battery Saver):" 
                                                           FontSize="11.5" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Tối ưu năng lượng khi dùng pin trên máy tính xách tay" 
                                                           FontSize="11" 
                                                           Foreground="{DynamicResource TextMutedBrush}" 
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="🪫 Bật Tiết Kiệm Pin" 
                                                        Height="30" Padding="12,0" Margin="0,0,6,0"
                                                        Background="{DynamicResource SearchBarBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                        FontSize="11" Cursor="Hand"
                                                        Click="OnEnableBatterySaverClicked"/>
                                                <Button Content="🔋 Nguồn Cân Bằng" 
                                                        Height="30" Padding="10,0" Margin="0,0,6,0"
                                                        Background="{DynamicResource SearchBarBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                        FontSize="11" Cursor="Hand"
                                                        Click="OnDisableBatterySaverClicked"/>
                                                <Button Content="Cài đặt Pin ↗" 
                                                        Height="30" Padding="10,0"
                                                        Background="Transparent" Foreground="{DynamicResource AccentBrush}"
                                                        FontSize="11" BorderThickness="0" Cursor="Hand"
                                                        Click="OnOpenBatterySettingsClicked"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 4: VỊ TRÍ & CĂN LỀ THANH TASKBAR -->
                            <Border Background="{DynamicResource CardBgBrush}" 
                                    BorderBrush="{DynamicResource CardBorderBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="12" 
                                    Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Vị trí &amp; Căn lề thanh Taskbar" 
                                               FontSize="12" 
                                               FontWeight="Bold" 
                                               Foreground="{DynamicResource AccentBrush}" 
                                               Margin="0,0,0,10"/>

                                    <TextBlock Text="Vị trí thanh Taskbar (Windows sẽ tự động khởi động lại Explorer để áp dụng):" 
                                               FontSize="11.5" 
                                               FontWeight="SemiBold" 
                                               Foreground="{DynamicResource TextPrimaryBrush}" 
                                               Margin="0,0,0,6"/>
                                    <WrapPanel Margin="0,0,0,12">
                                        <Button Content="Dưới cùng (Mặc định)" 
                                                Height="30" Padding="12,0" Margin="0,0,6,6"
                                                Background="{DynamicResource SearchBarBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                FontSize="11" Cursor="Hand"
                                                Click="OnSetTaskbarBottomClicked"/>
                                        <Button Content="Trên cùng" 
                                                Height="30" Padding="12,0" Margin="0,0,6,6"
                                                Background="{DynamicResource SearchBarBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                FontSize="11" Cursor="Hand"
                                                Click="OnSetTaskbarTopClicked"/>
                                        <Button Content="Bên trái" 
                                                Height="30" Padding="12,0" Margin="0,0,6,6"
                                                Background="{DynamicResource SearchBarBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                FontSize="11" Cursor="Hand"
                                                Click="OnSetTaskbarLeftClicked"/>
                                        <Button Content="Bên phải" 
                                                Height="30" Padding="12,0" Margin="0,0,6,6"
                                                Background="{DynamicResource SearchBarBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                FontSize="11" Cursor="Hand"
                                                Click="OnSetTaskbarRightClicked"/>
                                    </WrapPanel>

                                    <TextBlock Text="Căn lề biểu tượng Taskbar (Windows 11):" 
                                               FontSize="11.5" 
                                               FontWeight="SemiBold" 
                                               Foreground="{DynamicResource TextPrimaryBrush}" 
                                               Margin="0,0,0,6"/>
                                    <WrapPanel>
                                        <Button Content="🎯 Căn giữa (Center)" 
                                                Height="30" Padding="14,0" Margin="0,0,8,6"
                                                Background="{DynamicResource SearchBarBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                FontSize="11" Cursor="Hand"
                                                Click="OnSetTaskbarAlignCenterClicked"/>
                                        <Button Content="◀️ Căn lề trái (Left)" 
                                                Height="30" Padding="14,0" Margin="0,0,8,6"
                                                Background="{DynamicResource SearchBarBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                FontSize="11" Cursor="Hand"
                                                Click="OnSetTaskbarAlignLeftClicked"/>
                                        <Button Content="Cài đặt Taskbar ↗" 
                                                Height="30" Padding="10,0" Margin="0,0,0,6"
                                                Background="Transparent" Foreground="{DynamicResource AccentBrush}"
                                                FontSize="11" BorderThickness="0" Cursor="Hand"
                                                Click="OnOpenTaskbarSettingsClicked"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Footer Buttons -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Local AI Launcher v1.0" 
                           FontSize="11" 
                           Foreground="{DynamicResource TextMutedBrush}" 
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="↻ Khởi động lại"
                            Height="34"
                            Padding="12,0"
                            Margin="0,0,8,0"
                            Background="{DynamicResource SearchBarBgBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="OnRestartClicked"/>

                    <Button Content="Lưu &amp; Đóng"
                            Width="110" Height="34"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="#FFFFFF"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="OnSaveAndCloseClicked">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Border>
</Window>

