                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 1.8: TÙY BIẾN MÀU ĐIỂM NHẤN RIÊNG CHO APP (ACCENT COLOR NHƯ WINDOWS) -->
