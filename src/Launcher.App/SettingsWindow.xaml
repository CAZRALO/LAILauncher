<Window x:Class="Launcher.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cài đặt - Local AI Launcher"
        Height="620" Width="740"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <Style x:Key="ThemeCardRadioStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="ThemeGroup"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Foreground" Value="{DynamicResource IconBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="cardBorder" 
                                Background="{DynamicResource SearchBarBgBrush}" 
                                BorderBrush="{DynamicResource CardBorderBrush}" 
                                BorderThickness="1.5" 
                                CornerRadius="4" 
                                TextElement.Foreground="{DynamicResource IconBrush}"
                                Padding="6,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="cardBorder" Property="Background" Value="{DynamicResource ItemSelectedBgBrush}"/>
                                <Setter TargetName="cardBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Web Studio Theme Swatch Card Style (3x3 grid) -->
        <Style x:Key="ThemeSwatchRadioStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="swatchBorder" 
                                Background="{DynamicResource CardBgBrush}" 
                                BorderBrush="{DynamicResource CardBorderBrush}" 
                                BorderThickness="1.5" 
                                CornerRadius="10" 
                                Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="swatchBorder" Property="Background" Value="{DynamicResource ItemHoverBgBrush}"/>
                                <Setter TargetName="swatchBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="swatchBorder" Property="Background" Value="{DynamicResource ItemSelectedBgBrush}"/>
                                <Setter TargetName="swatchBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="swatchBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentChipStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chipBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="13" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chipBorder" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="chipBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center">
                            <Border Height="6" CornerRadius="3" Background="{DynamicResource SearchBarBgBrush}" BorderBrush="{DynamicResource SearchBarBorderBrush}" BorderThickness="1"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentBrush}" BorderBrush="#FFFFFF" BorderThickness="2" Cursor="Hand">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.3"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBgBrush}" 
            BorderBrush="{DynamicResource WindowBorderBrush}" 
            BorderThickness="1" 
            CornerRadius="{DynamicResource WindowCornerRadius}" 
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="3" Direction="270" 
                              Color="{DynamicResource ShadowColor}" 
                              Opacity="{DynamicResource ShadowOpacity}"/>
        </Border.Effect>

        <Grid>
            <!-- Specular top highlight -->
            <Border Height="1.5" VerticalAlignment="Top" 
                    Background="{DynamicResource GlassSpecularBrush}" 
                    CornerRadius="{DynamicResource WindowCornerRadiusTop}"
                    IsHitTestVisible="False"/>

            <Grid Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- Content -->
                    <RowDefinition Height="Auto"/> <!-- Footer Buttons -->
                </Grid.RowDefinitions>

                <!-- Title & Close -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource GeoSettings}" 
                              Width="18" Height="18" 
                              Stroke="{DynamicResource IconBrush}" 
                              StrokeThickness="1.5" 
                              Stretch="Uniform" 
                              Margin="0,0,10,0" 
                              VerticalAlignment="Center"/>
                        <TextBlock Text="Cài đặt" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1" 
                            Width="28" Height="28" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Cursor="Hand"
                            ToolTip="Đóng (Esc)"
                            Click="OnCloseClicked">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="7">
                                                <Path x:Name="clearPath" Data="{StaticResource GeoClear}" Width="10" Height="10" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.8" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource ItemHoverBgBrush}"/>
                                                    <Setter TargetName="clearPath" Property="Stroke" Value="{DynamicResource TextPrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

            <!-- Settings navigation and content -->
            <TabControl Grid.Row="1" TabStripPlacement="Left" BorderThickness="0" Background="Transparent" Margin="0,0,0,16">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Width" Value="132"/>
                        <Setter Property="Height" Value="38"/>
                        <Setter Property="Margin" Value="0,0,10,6"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ItemSelectedBgBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ItemHoverBgBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.ItemContainerStyle>
                <TabItem Header="Giao diện">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16,0,0,0">
                        <StackPanel>
                    <!-- SECTION 0: KIỂU HỆ ĐIỀU HÀNH & CHẾ ĐỘ SÁNG / TỐI (OS STYLE & DUAL MODE) -->
                    <Border Background="{DynamicResource CardBgBrush}" 
                            BorderBrush="{DynamicResource CardBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="12" 
                            Padding="16"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Kiểu Hệ Điều Hành &amp; Chế Độ Kính Mờ (Liquid Glass OS)" 
                                       FontSize="12" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource AccentBrush}" 
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Lựa chọn phong cách viền &amp; thanh điều khiển (Windows 11 vs Linux GNOME) cùng chế độ hiển thị kép:" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource TextSecondaryBrush}" 
                                       Margin="0,0,0,12"/>

                            <!-- OS Style Selector Grid -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Windows 11 Option Card -->
                                <RadioButton Grid.Column="0" x:Name="OsStyleWindowsRadio" GroupName="OsStyleGroup" Style="{StaticResource ThemeCardRadioStyle}" Checked="OnOsStyleSelectionChanged">
                                    <StackPanel HorizontalAlignment="Center" Margin="4,2">
                                        <Path Data="{StaticResource GeoWindows}" Width="20" Height="20" Fill="{DynamicResource AccentBrush}" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock Text="Windows 11 Fluent" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Bo góc 14px • Caption controls bên phải" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- Linux GNOME Option Card -->
                                <RadioButton Grid.Column="2" x:Name="OsStyleLinuxRadio" GroupName="OsStyleGroup" Style="{StaticResource ThemeCardRadioStyle}" Checked="OnOsStyleSelectionChanged">
                                    <StackPanel HorizontalAlignment="Center" Margin="4,2">
                                        <Path Data="{StaticResource GeoLinuxTux}" Width="20" Height="20" Fill="{DynamicResource AccentBrush}" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock Text="Linux GNOME Adwaita" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Bo góc 20px pill • 3 Traffic dots bên trái" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </Grid>

                            <!-- Dual Mode Selector: Dark vs Light Mode -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Force Dark Mode Card -->
                                <RadioButton Grid.Column="0" x:Name="ModeForceDarkRadio" GroupName="DualModeGroup" Style="{StaticResource ThemeCardRadioStyle}" Checked="OnDualModeSelectionChanged">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
                                        <TextBlock Text="🌙" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Chế độ Tối (Dark Glass)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Nền kính mờ obsidian ban đêm" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>

                                <!-- Force Light Mode Card -->
                                <RadioButton Grid.Column="2" x:Name="ModeForceLightRadio" GroupName="DualModeGroup" Style="{StaticResource ThemeCardRadioStyle}" Checked="OnDualModeSelectionChanged">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
                                        <TextBlock Text="☀️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Chế độ Sáng (Light Glass)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Nền kính mờ sương sữa thanh lịch" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 1: BẢNG MÀU & THEME ĐA DẠNG (LIQUID GLASS OS PRESETS - EXACT MATCH WITH WEB) -->
                    <Border Background="{DynamicResource CardBgBrush}" 
                            BorderBrush="{DynamicResource CardBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="12" 
                            Padding="16"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="🎨 Bảng Màu &amp; Theme Đa Dạng (Liquid Glass OS Studio)" 
                                       FontSize="12" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource AccentBrush}" 
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="9 bộ phối màu cao cấp đồng bộ 100% với Web Studio — Hỗ trợ cả 2 chế độ Sáng &amp; Tối:" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource TextSecondaryBrush}" 
                                       Margin="0,0,0,12"/>
                            
                            <!-- 3x3 Theme Swatches Grid (matching web theme-swatch-grid) -->
                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                <!-- 1. Windows Fluent Blue (#3B82F6) -->
                                <RadioButton x:Name="ThemeWinFluentRadio" GroupName="ThemePresetGroup" Style="{StaticResource ThemeSwatchRadioStyle}" Checked="OnThemeChanged">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="#3B82F6" BorderBrush="#FFFFFF" BorderThickness="1.5" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#3B82F6" Opacity="0.4"/>
                                            </Border.Effect>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Windows Fluent Blue" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="#3B82F6 • Mặc định" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </RadioButton>

                                <!-- 2. Ubuntu Yaru Orange (#E95420) -->
                                <RadioButton x:Name="ThemeUbuntuRadio" GroupName="ThemePresetGroup" Style="{StaticResource ThemeSwatchRadioStyle}" Checked="OnThemeChanged">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="#E95420" BorderBrush="#FFFFFF" BorderThickness="1.5" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#E95420" Opacity="0.4"/>
                                            </Border.Effect>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Ubuntu Yaru Orange" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="#E95420 • Cam Yaru" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </RadioButton>

                                <!-- 3. Arch / Fedora Cyan (#00AAD4) -->
                                <RadioButton x:Name="ThemeArchRadio" GroupName="ThemePresetGroup" Style="{StaticResource ThemeSwatchRadioStyle}" Checked="OnThemeChanged">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="#00AAD4" BorderBrush="#FFFFFF" BorderThickness="1.5" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#00AAD4" Opacity="0.4"/>
                                            </Border.Effect>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Arch / Fedora Cyan" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="#00AAD4 • Xanh băng" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </RadioButton>

                                <!-- 4. Liquid Aurora Glass (#8B5CF6) -->
                                <RadioButton x:Name="ThemeAuroraRadio" GroupName="ThemePresetGroup" Style="{StaticResource ThemeSwatchRadioStyle}" Checked="OnThemeChanged">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="#8B5CF6" BorderBrush="#FFFFFF" BorderThickness="1.5" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#8B5CF6" Opacity="0.4"/>
                                            </Border.Effect>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Liquid Aurora Glass" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="#8B5CF6 • Cực quang tím" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </RadioButton>

                                <!-- 5. Cyberpunk Neon (#F43F5E) -->
                                <RadioButton x:Name="ThemeCyberpunkRadio" GroupName="ThemePresetGroup" Style="{StaticResource ThemeSwatchRadioStyle}" Checked="OnThemeChanged">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="#F43F5E" BorderBrush="#FFFFFF" BorderThickness="1.5" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#F43F5E" Opacity="0.4"/>
                                            </Border.Effect>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Cyberpunk Neon" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="#F43F5E • Hồng neon" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </RadioButton>

                                <!-- 6. Nordic Frost Slate (#88C0D0) -->
                                <RadioButton x:Name="ThemeNordRadio" GroupName="ThemePresetGroup" Style="{StaticResource ThemeSwatchRadioStyle}" Checked="OnThemeChanged">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="#88C0D0" BorderBrush="#FFFFFF" BorderThickness="1.5" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#88C0D0" Opacity="0.4"/>
                                            </Border.Effect>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Nordic Frost Slate" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="#88C0D0 • Bắc Âu lạnh" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </RadioButton>

                                <!-- 7. Dracula Nocturne (#BD93F9) -->
                                <RadioButton x:Name="ThemeDraculaRadio" GroupName="ThemePresetGroup" Style="{StaticResource ThemeSwatchRadioStyle}" Checked="OnThemeChanged">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="#BD93F9" BorderBrush="#FFFFFF" BorderThickness="1.5" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#BD93F9" Opacity="0.4"/>
                                            </Border.Effect>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Dracula Nocturne" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="#BD93F9 • Dạ khúc tím" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </RadioButton>

                                <!-- 8. Emerald Jade Mint (#10B981) -->
                                <RadioButton x:Name="ThemeEmeraldRadio" GroupName="ThemePresetGroup" Style="{StaticResource ThemeSwatchRadioStyle}" Checked="OnThemeChanged">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="#10B981" BorderBrush="#FFFFFF" BorderThickness="1.5" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#10B981" Opacity="0.4"/>
                                            </Border.Effect>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Emerald Jade Mint" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="#10B981 • Ngọc lục bảo" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </RadioButton>

                                <!-- 9. Sunset Dusk Coral (#FB923C) -->
                                <RadioButton x:Name="ThemeSunsetRadio" GroupName="ThemePresetGroup" Style="{StaticResource ThemeSwatchRadioStyle}" Checked="OnThemeChanged">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="#FB923C" BorderBrush="#FFFFFF" BorderThickness="1.5" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#FB923C" Opacity="0.4"/>
                                            </Border.Effect>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Sunset Dusk Coral" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="#FB923C • Hoàng hôn san hô" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </RadioButton>
