                                             Foreground="{DynamicResource TextPrimaryBrush}" 
                                             BorderBrush="{DynamicResource SearchBarBorderBrush}" 
                                             BorderThickness="1" 
                                             FontSize="13" 
                                             FontFamily="Consolas" 
                                             FontWeight="SemiBold"
                                             TextChanged="OnCustomAccentTextChanged"/>

                                    <TextBlock Grid.Column="2" 
                                               Text="Mã HEX tùy chọn (#RRGGBB)" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource TextMutedBrush}" 
                                               VerticalAlignment="Center" 
                                               Margin="10,0,0,0"/>

                                    <Button Grid.Column="3" 
                                            Content="Áp dụng" 
                                            Height="32" Padding="14,0" 
                                            Background="{DynamicResource AccentBrush}" 
                                            Foreground="#FFFFFF" 
                                            FontWeight="SemiBold" 
                                            FontSize="12" 
                                            BorderThickness="0" 
                                            Cursor="Hand" 
                                            Click="OnApplyAccentClicked">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Option: Apply Accent Color to Window Border (Windows 11 style) -->
                            <CheckBox x:Name="AccentOnBorderCheckBox" 
                                      Content="Hiển thị màu điểm nhấn trên viền cửa sổ (Window border accent)" 
                                      FontSize="12" 
                                      FontWeight="SemiBold" 
                                      Margin="0,2,0,0"
                                      Checked="OnAccentOnBorderChanged" 
                                      Unchecked="OnAccentOnBorderChanged"/>
                        </StackPanel>
                    </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Màn hình">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16,0,0,0">
                        <StackPanel>
                            <!-- SECTION: CHẾ ĐỘ HIỂN THỊ MÀN HÌNH (MONITOR SELECTION) -->
                            <Border Background="{DynamicResource CardBgBrush}" 
                                    BorderBrush="{DynamicResource CardBorderBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="12" 
                                    Padding="16"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource GeoMonitor}" Width="16" Height="16" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Chọn Màn Hình Hiển Thị (Đa Màn Hình)" 
                                                       FontSize="12" 
                                                       FontWeight="Bold" 
                                                       Foreground="{DynamicResource AccentBrush}" 
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" 
                                                x:Name="RefreshMonitorsBtn"
                                                Content="🔄 Quét lại màn hình" 
                                                Padding="10,4" 
                                                FontSize="11" 
                                                FontWeight="SemiBold"
                                                Background="{DynamicResource SearchBarBgBrush}"
                                                Foreground="{DynamicResource AccentBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                Click="OnRefreshMonitorsClicked"/>
                                    </Grid>
                                    
                                    <TextBlock Text="Tùy chỉnh màn hình mà LAILauncher sẽ xuất hiện khi bạn nhấn phím tắt kích hoạt (Alt + Space). Rất hữu ích khi kết nối 2 hoặc nhiều màn hình:" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource TextSecondaryBrush}" 
                                               Margin="0,0,0,12"/>

                                    <!-- 4 Target Monitor Modes Grid -->
                                    <UniformGrid Columns="2" Margin="0,0,0,10">
                                        <!-- Option 1: Theo con trỏ chuột (Recommended) -->
                                        <RadioButton x:Name="MonitorModeCursorRadio" 
                                                     GroupName="MonitorTargetModeGroup" 
                                                     Style="{StaticResource ThemeCardRadioStyle}" 
                                                     Checked="OnMonitorModeSelectionChanged">
                                            <StackPanel Margin="6,4">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="🖱️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Theo con trỏ chuột" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <Border Background="#22C55E" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Khuyên dùng" FontSize="8.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="Tự động mở trên màn hình mà con trỏ chuột đang nằm ở đó" 
                                                           FontSize="10" 
                                                           Foreground="{DynamicResource TextMutedBrush}" 
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </RadioButton>

                                        <!-- Option 2: Màn hình chính (Primary) -->
                                        <RadioButton x:Name="MonitorModePrimaryRadio" 
                                                     GroupName="MonitorTargetModeGroup" 
                                                     Style="{StaticResource ThemeCardRadioStyle}" 
                                                     Checked="OnMonitorModeSelectionChanged">
                                            <StackPanel Margin="6,4">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="🌟" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Màn hình chính Windows" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="Luôn luôn hiển thị cố định tại màn hình chính mặc định của Windows" 
