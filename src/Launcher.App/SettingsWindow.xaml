                                                           FontSize="10" 
                                                           Foreground="{DynamicResource TextMutedBrush}" 
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>

                                    <!-- Specific Monitor Selector Dropdown Panel (Shown when Option 4 is active) -->
