                            </Border>

                            <!-- Manual Accent Palette & Custom Hex -->
                            <StackPanel x:Name="AccentPalettePanel">
                                <TextBlock Text="Bảng màu chuẩn Windows 11 (Windows Accent Colors):" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource TextMutedBrush}" 
                                           Margin="0,0,0,6"/>

                                <!-- 24 Windows 11 Curated Accent Palette -->
                                <WrapPanel x:Name="AccentChipsWrapPanel" Margin="0,0,0,12" HorizontalAlignment="Left">
                                    <!-- Blue / Cyan -->
                                    <Button Style="{StaticResource AccentChipStyle}" Background="#0078D7" ToolTip="Windows Blue (#0078D7)" Tag="#0078D7" Click="OnPresetAccentClicked"/>
                                    <Button Style="{StaticResource AccentChipStyle}" Background="#0284C7" ToolTip="Sky Blue (#0284C7)" Tag="#0284C7" Click="OnPresetAccentClicked"/>
                                    <Button Style="{StaticResource AccentChipStyle}" Background="#06B6D4" ToolTip="Electric Cyan (#06B6D4)" Tag="#06B6D4" Click="OnPresetAccentClicked"/>
                                    <Button Style="{StaticResource AccentChipStyle}" Background="#0D9488" ToolTip="Teal Lagoon (#0D9488)" Tag="#0D9488" Click="OnPresetAccentClicked"/>
                                    <Button Style="{StaticResource AccentChipStyle}" Background="#14B8A6" ToolTip="Arctic Mint (#14B8A6)" Tag="#14B8A6" Click="OnPresetAccentClicked"/>
                                    <Button Style="{StaticResource AccentChipStyle}" Background="#38BDF8" ToolTip="Sky Frost (#38BDF8)" Tag="#38BDF8" Click="OnPresetAccentClicked"/>

                                    <!-- Green / Lime -->
                                    <Button Style="{StaticResource AccentChipStyle}" Background="#10B981" ToolTip="Emerald (#10B981)" Tag="#10B981" Click="OnPresetAccentClicked"/>
                                    <Button Style="{StaticResource AccentChipStyle}" Background="#059669" ToolTip="Deep Forest (#059669)" Tag="#059669" Click="OnPresetAccentClicked"/>
                                    <Button Style="{StaticResource AccentChipStyle}" Background="#22C55E" ToolTip="Spring Green (#22C55E)" Tag="#22C55E" Click="OnPresetAccentClicked"/>
                                    <Button Style="{StaticResource AccentChipStyle}" Background="#84CC16" ToolTip="Vibrant Lime (#84CC16)" Tag="#84CC16" Click="OnPresetAccentClicked"/>

                                    <!-- Gold / Orange -->
                                    <Button Style="{StaticResource AccentChipStyle}" Background="#EAB308" ToolTip="Yellow Gold (#EAB308)" Tag="#EAB308" Click="OnPresetAccentClicked"/>
                                    <Button Style="{StaticResource AccentChipStyle}" Background="#F59E0B" ToolTip="Amber Gold (#F59E0B)" Tag="#F59E0B" Click="OnPresetAccentClicked"/>
                                    <Button Style="{StaticResource AccentChipStyle}" Background="#F97316" ToolTip="Vibrant Orange (#F97316)" Tag="#F97316" Click="OnPresetAccentClicked"/>
                                    <Button Style="{StaticResource AccentChipStyle}" Background="#FB7185" ToolTip="Coral Rose (#FB7185)" Tag="#FB7185" Click="OnPresetAccentClicked"/>

                                    <!-- Red / Pink -->
                                    <Button Style="{StaticResource AccentChipStyle}" Background="#E11D48" ToolTip="Crimson Red (#E11D48)" Tag="#E11D48" Click="OnPresetAccentClicked"/>
                                    <Button Style="{StaticResource AccentChipStyle}" Background="#F43F5E" ToolTip="Neon Rose (#F43F5E)" Tag="#F43F5E" Click="OnPresetAccentClicked"/>
                                    <Button Style="{StaticResource AccentChipStyle}" Background="#EC4899" ToolTip="Hot Pink (#EC4899)" Tag="#EC4899" Click="OnPresetAccentClicked"/>
                                    <Button Style="{StaticResource AccentChipStyle}" Background="#D946EF" ToolTip="Fuchsia Magenta (#D946EF)" Tag="#D946EF" Click="OnPresetAccentClicked"/>

                                    <!-- Purple / Violet -->
                                    <Button Style="{StaticResource AccentChipStyle}" Background="#A855F7" ToolTip="Purple Violet (#A855F7)" Tag="#A855F7" Click="OnPresetAccentClicked"/>
                                    <Button Style="{StaticResource AccentChipStyle}" Background="#8B5CF6" ToolTip="Royal Orchid (#8B5CF6)" Tag="#8B5CF6" Click="OnPresetAccentClicked"/>
                                    <Button Style="{StaticResource AccentChipStyle}" Background="#6366F1" ToolTip="Modern Indigo (#6366F1)" Tag="#6366F1" Click="OnPresetAccentClicked"/>
                                    <Button Style="{StaticResource AccentChipStyle}" Background="#4F46E5" ToolTip="Deep Iris (#4F46E5)" Tag="#4F46E5" Click="OnPresetAccentClicked"/>

                                    <!-- Slate / Neutral -->
                                    <Button Style="{StaticResource AccentChipStyle}" Background="#64748B" ToolTip="Slate Steel (#64748B)" Tag="#64748B" Click="OnPresetAccentClicked"/>
                                    <Button Style="{StaticResource AccentChipStyle}" Background="#71717A" ToolTip="Neutral Zinc (#71717A)" Tag="#71717A" Click="OnPresetAccentClicked"/>
                                </WrapPanel>

                                <!-- Custom HEX Input Row -->
                                <Grid Margin="0,0,0,12">
