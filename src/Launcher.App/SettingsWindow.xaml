                                        <Button Style="{StaticResource AccentChipStyle}" Background="#0E1015" ToolTip="Kính Than Chì Obsidian (#0E1015)" Tag="#0E1015" Click="OnPresetGlassTintClicked"/>
                                        <Button Style="{StaticResource AccentChipStyle}" Background="#171C26" ToolTip="Kính Khói Slate (#171C26)" Tag="#171C26" Click="OnPresetGlassTintClicked"/>
                                        <Button Style="{StaticResource AccentChipStyle}" Background="#1A1429" ToolTip="Kính Thạch Anh Tím (#1A1429)" Tag="#1A1429" Click="OnPresetGlassTintClicked"/>
                                        <Button Style="{StaticResource AccentChipStyle}" Background="#0A1813" ToolTip="Kính Rừng Ngọc Lục Bảo (#0A1813)" Tag="#0A1813" Click="OnPresetGlassTintClicked"/>
