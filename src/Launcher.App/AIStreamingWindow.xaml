<Window x:Class="Launcher.App.AIStreamingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Local AI Assistant"
        Height="540" Width="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SearchBarBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource ItemHoverBgBrush}"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBgBrush}" 
            BorderBrush="{DynamicResource WindowBorderBrush}" 
            BorderThickness="1" 
            CornerRadius="{DynamicResource WindowCornerRadius}" 
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" 
                              Color="{DynamicResource ShadowColor}" 
                              Opacity="{DynamicResource ShadowOpacity}"/>
        </Border.Effect>

        <Grid>
            <!-- Ambient Aurora Refraction Glow Mesh behind glass (Identical to Web) -->
            <Grid IsHitTestVisible="False">
                <Ellipse Width="350" Height="250" 
                         HorizontalAlignment="Right" VerticalAlignment="Top" 
                         Margin="0,-50,-50,0" 
                         Opacity="0.18">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="260" Height="200" 
                         HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                         Margin="-40,0,0,-40" 
                         Opacity="0.12">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{DynamicResource LogoColor}" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <!-- Specular Sheen Rim Reflection (Top edge highlight) -->
            <Border Height="1.5" VerticalAlignment="Top" 
                    Background="{DynamicResource GlassSpecularBrush}" 
                    CornerRadius="{DynamicResource WindowCornerRadiusTop}"
                    IsHitTestVisible="False"/>

            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Prompt Card -->
                    <RowDefinition Height="*"/>    <!-- Streaming Response Body -->
                    <RowDefinition Height="Auto"/> <!-- Footer Action Bar -->
                </Grid.RowDefinitions>

                <!-- 1. Header (Draggable) -->
                <Grid Grid.Row="0" Margin="0,0,0,12" MouseLeftButtonDown="OnHeaderMouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource GeoSparkle}" Width="15" Height="15" Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Trợ lý AI Cục Bộ" 
                                   FontSize="15.5" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,10,0"/>

                        <!-- Model Badge -->
                        <Border Background="{DynamicResource BadgeBgBrush}" 
                                BorderBrush="{DynamicResource BadgeBorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="8,3" 
                                Margin="0,0,6,0" 
                                VerticalAlignment="Center">
                            <TextBlock x:Name="ModelBadgeText" 
                                       Text="llama3.2:1b" 
                                       FontSize="11" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>

                        <!-- Status Badge -->
                        <Border x:Name="StatusBorder" 
                                Background="#2210B981" 
                                BorderBrush="#4410B981" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="8,3" 
                                Margin="0,0,6,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="StatusBadgeText" 
                                       Text="Đang xử lý" 
                                       FontSize="11" 
                                       FontWeight="SemiBold" 
                                       Foreground="#10B981"/>
                        </Border>

                        <!-- Offline 100% Badge (Exact match with web) -->
                        <Border Background="{DynamicResource BadgeBgBrush}" 
                                BorderBrush="{DynamicResource BadgeBorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="8,3" 
                                VerticalAlignment="Center">
                            <TextBlock Text="Offline 100%" 
                                       FontSize="11" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="2" 
                            Width="28" Height="28" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Cursor="Hand"
                            ToolTip="Đóng (Esc)"
                            Click="OnCloseClicked">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="7">
                                                <Path x:Name="clearPath" Data="{StaticResource GeoClear}" Width="10" Height="10" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.8" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource ItemHoverBgBrush}"/>
                                                    <Setter TargetName="clearPath" Property="Stroke" Value="{DynamicResource TextPrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- 2. Prompt Card -->
                <Border Grid.Row="1" 
                        Background="{DynamicResource CardBgBrush}" 
                        BorderBrush="{DynamicResource CardBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="12,8" 
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource GeoEnter}" Width="13" Height="13" Stroke="{DynamicResource IconMutedBrush}" StrokeThickness="1.5" Margin="0,2,8,0" VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1" 
                                   x:Name="PromptText" 
                                   Text="Đang tải prompt..." 
                                   FontSize="13" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                   TextWrapping="Wrap" 
                                   MaxHeight="60" 
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

                <!-- 3. Streaming Response Area -->
                <Border Grid.Row="2" 
                        Background="{DynamicResource SearchBarBgBrush}" 
                        BorderBrush="{DynamicResource SearchBarBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="14,12" 
                        Margin="0,0,0,14">
                    <ScrollViewer x:Name="ResponseScrollViewer" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="ResponseTextBox" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Foreground="{DynamicResource TextPrimaryBrush}" 
                                 FontSize="14" 
                                 FontFamily="Segoe UI Variable Text, Segoe UI, Consolas, sans-serif" 
                                 TextWrapping="Wrap" 
                                 IsReadOnly="True" 
                                 IsReadOnlyCaretVisible="True" 
                                 CaretBrush="{DynamicResource AccentBrush}"/>
                    </ScrollViewer>
                </Border>

                <!-- 4. Footer Action Bar -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TimeElapsedText" 
                                   Text="⏱ 0.0 s" 
                                   FontSize="11.5" 
                                   Foreground="{DynamicResource TextMutedBrush}" 
                                   Margin="0,0,10,0" 
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TokenEstimateText" 
                                   Text="0 từ" 
                                   FontSize="11.5" 
                                   Foreground="{DynamicResource TextMutedBrush}" 
                                   Margin="0,0,12,0" 
                                   VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource BadgeBgBrush}" 
                                CornerRadius="5" 
                                Padding="6,2" 
                                VerticalAlignment="Center">
                            <TextBlock Text="Ollama Local ONNX" 
                                       FontSize="10.5" 
                                       FontWeight="Medium" 
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="CopyButton" 
                                Style="{StaticResource ActionButtonStyle}" 
                                Content="Sao chép (Ctrl+C)" 
                                Margin="0,0,8,0" 
                                Click="OnCopyClicked"/>
                        <Button x:Name="StopButton" 
                                Style="{StaticResource ActionButtonStyle}" 
                                Content="Dừng lại" 
                                Margin="0,0,8,0" 
                                Click="OnStopClicked"/>
                        <Button Style="{StaticResource ActionButtonStyle}" 
                                Content="Đóng (Esc)" 
                                Click="OnCloseClicked"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
