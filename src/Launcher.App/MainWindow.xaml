<Window x:Class="Launcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:Launcher.App.Converters"
        mc:Ignorable="d"
        Title="LAILauncher"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="460" Width="680"
        MinHeight="340" MinWidth="520"
        MaxHeight="860" MaxWidth="1200"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Deactivated="OnWindowDeactivated">

    <Window.Resources>
        <conv:ResultToIconConverter x:Key="ResultToIconConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <conv:ResultTypeToColorConverter x:Key="ResultTypeToColorConverter"/>
        <conv:ResultTypeToBackgroundConverter x:Key="ResultTypeToBackgroundConverter"/>
        <conv:ResultTypeToBorderConverter x:Key="ResultTypeToBorderConverter"/>
        <conv:ResultTypeToGeometryConverter x:Key="ResultTypeToGeometryConverter"/>
        <conv:ResultTypeToDisplayNameConverter x:Key="ResultTypeToDisplayNameConverter"/>

        <!-- Quick Settings Button Style (WrapPanel Pill Bar) -->
        <Style x:Key="QuickSettingBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,5,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{DynamicResource BadgeBgBrush}" BorderBrush="{DynamicResource BadgeBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource PillCornerRadius}" Padding="8,3.5">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBgBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dynamic Context Menu -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource ContextMenuBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ContextMenuBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource ContextMenuBgBrush}"
                                BorderBrush="{DynamicResource ContextMenuBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270"
                                                  Color="{DynamicResource ShadowColor}"
                                                  Opacity="{DynamicResource ShadowOpacity}"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Icon"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0" ContentSource="Icon" TextElement.Foreground="{DynamicResource IconBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontFamily="Segoe UI, Consolas, monospace" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuBorder" Property="Background" Value="{DynamicResource ItemHoverBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Flyout Menu Button Style -->
        <Style x:Key="FlyoutButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBd" Property="Background" Value="{DynamicResource ItemHoverBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Liquid Glass Native OS Container -->
    <Border Background="{DynamicResource WindowBgBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="{DynamicResource WindowBorderThickness}"
            CornerRadius="{DynamicResource WindowCornerRadius}"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270"
                              Color="{DynamicResource ShadowColor}"
                              Opacity="{DynamicResource ShadowOpacity}"/>
        </Border.Effect>

        <Grid>
            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="OrbPrimaryTrans" Storyboard.TargetProperty="X" From="0" To="35" Duration="0:0:9">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="OrbPrimaryTrans" Storyboard.TargetProperty="Y" From="0" To="20" Duration="0:0:7">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="OrbSecondaryTrans" Storyboard.TargetProperty="X" From="0" To="-30" Duration="0:0:8">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="OrbSecondaryTrans" Storyboard.TargetProperty="Y" From="0" To="-25" Duration="0:0:10">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="OrbTertiaryTrans" Storyboard.TargetProperty="X" From="-15" To="20" Duration="0:0:11">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>

            <!-- Ambient Aurora Refraction Glow Mesh -->
            <Grid IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse x:Name="OrbPrimary" Width="380" Height="260" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-100,-70,0,0" Opacity="0.09" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="OrbPrimaryTrans"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse x:Name="OrbTertiary" Width="320" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.05" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="OrbTertiaryTrans"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="{DynamicResource LogoColor}" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse x:Name="OrbSecondary" Width="360" Height="240" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-80,-80" Opacity="0.07" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="OrbSecondaryTrans"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <!-- Specular Sheen Rim Reflection -->
            <Border Height="1.5" VerticalAlignment="Top"
                    Background="{DynamicResource GlassSpecularBrush}"
                    CornerRadius="{DynamicResource WindowCornerRadiusTop}"
                    IsHitTestVisible="False"/>

            <Grid Margin="14,8,14,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <!-- Linux GNOME Top Bar (Visible in Linux Mode) -->
                    <Border x:Name="GnomeTopBar"
                            Visibility="{DynamicResource LinuxVisibility}"
                            Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource SeparatorBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,5"
                            Margin="-16,-8,-16,8"
                            CornerRadius="{DynamicResource WindowCornerRadiusTop}"
                            MouseLeftButtonDown="OnWindowDragMouseDown"
                            Cursor="SizeAll">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource BadgeBgBrush}" BorderBrush="{DynamicResource BadgeBorderBrush}" BorderThickness="0.8" CornerRadius="10" Padding="8,2" Cursor="Hand">
                                <TextBlock Text="Activities" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Border>

                            <TextBlock Grid.Column="1" x:Name="GnomeClockText" Text="" FontSize="11" FontWeight="Medium" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoWifi}" Width="12" Height="12" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.4" Stretch="Uniform" Margin="0,0,8,0"/>
                                <Path Data="{StaticResource GeoVolume}" Width="12" Height="12" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.4" Stretch="Uniform" Margin="0,0,8,0"/>
                                <Path Data="{StaticResource GeoBattery}" Width="13" Height="12" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.4" Stretch="Uniform" Margin="0,0,8,0"/>
                                <Border Background="{DynamicResource BadgeBgBrush}" CornerRadius="9" Width="18" Height="18">
                                    <Path Data="{StaticResource GeoPower}" Width="9" Height="9" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.4" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Native OS Header Bar -->
                    <Grid x:Name="HeaderTitleBar"
                          Margin="2,0,2,6"
                          Background="Transparent"
                          MouseLeftButtonDown="OnWindowDragMouseDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: Linux Traffic Dots & Brand App Logo -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel x:Name="LinuxTrafficDots" Orientation="Horizontal" Visibility="{DynamicResource LinuxVisibility}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Button x:Name="LinuxCloseBtn" Width="13" Height="13" Margin="0,0,7,0" Cursor="Hand" ToolTip="{DynamicResource Str_Btn_CloseTooltip}" Click="OnWindowCloseClicked" Background="Transparent" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="dot" CornerRadius="6.5" Background="#FF5F56" Width="13" Height="13" BorderBrush="#E0443E" BorderThickness="0.8">
                                                <Path x:Name="dotGlyph" Data="{StaticResource GeoClear}" Stroke="#440000" StrokeThickness="1.2" Width="6" Height="6" Stretch="Uniform" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="dotGlyph" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="LinuxMinBtn" Width="13" Height="13" Margin="0,0,7,0" Cursor="Hand" ToolTip="{DynamicResource Str_Btn_MinimizeTooltip}" Click="OnWindowMinimizeClicked" Background="Transparent" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="dot" CornerRadius="6.5" Background="#FFBD2E" Width="13" Height="13" BorderBrush="#DEA123" BorderThickness="0.8">
                                                <Path x:Name="dotGlyph" Data="{StaticResource GeoMinimize}" Stroke="#443000" StrokeThickness="1.2" Width="6" Height="6" Stretch="Uniform" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="dotGlyph" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="LinuxMaxBtn" Width="13" Height="13" Cursor="Hand" ToolTip="{DynamicResource Str_Btn_SettingsTooltip}" Click="OnSettingsClicked" Background="Transparent" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="dot" CornerRadius="6.5" Background="#27C93F" Width="13" Height="13" BorderBrush="#1AAB29" BorderThickness="0.8">
                                                <Path x:Name="dotGlyph" Data="{StaticResource GeoSettings}" Stroke="#003300" StrokeThickness="1.2" Width="6" Height="6" Stretch="Uniform" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="dotGlyph" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <!-- Brand Logo & Title -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Cursor="SizeAll" ToolTip="{DynamicResource Str_DragGripTooltip}">
                                <Image Source="pack://application:,,,/Assets/app-logo.png"
                                       Width="16" Height="16"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>

                                <TextBlock Text="LAILauncher" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- RIGHT: Minimal Header Controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ResetPositionBtn" Click="OnResetPositionClicked" Width="24" Height="24" Margin="0,0,2,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Visibility="Collapsed">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBgBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Path x:Name="ResetPosIcon" Data="{StaticResource GeoReset}" Width="11" Height="11" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.4" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <Button x:Name="SettingsQuickBtn" Click="OnSettingsClicked" ToolTip="{DynamicResource Str_Btn_SettingsTooltip}" Width="24" Height="24" Margin="0,0,2,0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBgBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Path Data="{StaticResource GeoSettings}" Width="12" Height="12" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.4" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Windows Caption Controls (Close) -->
                            <StackPanel x:Name="WindowsCaptionControls" Orientation="Horizontal" Visibility="{DynamicResource WindowsVisibility}" VerticalAlignment="Center">
                                <Button x:Name="WinCloseBtn" Click="OnWindowCloseClicked" ToolTip="{DynamicResource Str_Btn_CloseTooltip}" Width="24" Height="24" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" CornerRadius="6" Background="Transparent">
                                                <Path x:Name="closeP" Data="{StaticResource GeoClear}" Width="8" Height="8" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                                    <Setter TargetName="closeP" Property="Stroke" Value="#FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Clean & Focused Search Bar Container -->
                <Border Grid.Row="1"
                        Background="{DynamicResource SearchBarBgBrush}"
                        CornerRadius="{DynamicResource SearchCornerRadius}"
                        Padding="{DynamicResource SearchPadding}"
                        BorderBrush="{DynamicResource SearchBarBorderBrush}"
                        BorderThickness="{DynamicResource SearchBorderThickness}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0"
                              Data="{StaticResource GeoSearch}"
                              Width="16" Height="16"
                              Stroke="{DynamicResource IconBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"/>

                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" x:Name="SearchPrefixBadge"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="6"
                                    Padding="7,2.5"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="SearchPrefixIcon" Data="{StaticResource GeoTerminal}" Width="10" Height="10" Fill="#FFFFFF" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SearchPrefixText" Text="Shell" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <TextBox x:Name="SearchBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontSize="15.5"
                                         FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                         FontWeight="Medium"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0"
                                         CaretBrush="{DynamicResource AccentBrush}"
                                         TextChanged="OnSearchTextChanged"/>

                                <TextBlock x:Name="PlaceholderText"
                                           Text="{DynamicResource Str_SearchPlaceholder}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="14.5"
                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           Margin="2,0,8,0"/>
                            </Grid>

                            <Button Grid.Column="2" x:Name="ClearSearchButton"
                                    Width="22" Height="22"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Visibility="Collapsed"
                                    Click="OnClearSearchClicked">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="clearBorder" Background="{DynamicResource BadgeBgBrush}" CornerRadius="11">
                                            <Path Data="{StaticResource GeoClear}" Width="8.5" Height="8.5" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.8" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="clearBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Wrapping Quick Settings Strip (Hidden by default; toggleable in Settings) -->
                <Border x:Name="QuickSettingsStrip" Grid.Row="2" Margin="0,7,0,0" Visibility="Collapsed">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="QuickHotspotBtn" Click="OnQuickHotspotClicked" ToolTip="Bật / Tắt Mobile Hotspot trực tiếp" Style="{StaticResource QuickSettingBtnStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="QuickHotspotDot" Width="6" Height="6" Fill="#64748B" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <Path Data="{StaticResource GeoHotspot}" Width="12" Height="12" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.4" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="QuickHotspotText" Text="{DynamicResource Str_Quick_Hotspot}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="QuickEnergySaverBtn" Click="OnQuickEnergySaverClicked" ToolTip="Bật / Tắt Tiết kiệm pin (Energy Saver) trực tiếp" Style="{StaticResource QuickSettingBtnStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="QuickEnergySaverDot" Width="6" Height="6" Fill="#64748B" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <Path x:Name="QuickEnergySaverIcon" Data="{StaticResource GeoLeaf}" Width="12" Height="12" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.4" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="QuickEnergySaverText" Text="{DynamicResource Str_Quick_Battery}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="QuickTaskbarAlignBtn" Click="OnQuickTaskbarAlignClicked" ToolTip="Đổi vị trí thanh Taskbar (Căn Giữa ↔ Căn Trái)" Style="{StaticResource QuickSettingBtnStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoTaskbar}" Width="12" Height="12" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.4" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="QuickTaskbarText" Text="{DynamicResource Str_Quick_TaskbarCenter}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="QuickScreenshotBtn" Click="OnQuickScreenshotClicked" MouseRightButtonUp="OnQuickScreenshotRightClicked" ToolTip="Chụp ảnh màn hình (Trái: Toàn màn hình, Phải: Snipping Tool)" Style="{StaticResource QuickSettingBtnStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoCamera}" Width="12" Height="12" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.4" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Str_Quick_Screenshot}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="QuickProcessesBtn" Click="OnQuickProcessesClicked" ToolTip="Xem danh sách trình chạy ngầm và mức tiêu thụ RAM" Style="{StaticResource QuickSettingBtnStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoCpu}" Width="12" Height="12" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.4" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Str_Quick_Processes}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="QuickWifiBtn" Click="OnQuickWifiClicked" MouseRightButtonUp="OnQuickWifiRightClicked" ToolTip="Nhấn trái: Bật / Tắt Wi-Fi | Nhấn phải: Danh sách Wi-Fi (sys wifi list)" Style="{StaticResource QuickSettingBtnStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="QuickWifiDot" Width="6" Height="6" Fill="#64748B" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <Path x:Name="QuickWifiIcon" Data="{StaticResource GeoWifi}" Width="12" Height="12" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.4" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="QuickWifiText" Text="{DynamicResource Str_Quick_Wifi}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="QuickBluetoothBtn" Click="OnQuickBluetoothClicked" MouseRightButtonUp="OnQuickBluetoothRightClicked" ToolTip="Nhấn trái: Bật / Tắt Bluetooth | Nhấn phải: Danh sách Bluetooth (sys bluetooth list)" Style="{StaticResource QuickSettingBtnStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="QuickBluetoothDot" Width="6" Height="6" Fill="#64748B" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <Path x:Name="QuickBluetoothIcon" Data="{StaticResource GeoBluetooth}" Width="12" Height="12" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.4" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="QuickBluetoothText" Text="{DynamicResource Str_Quick_Bluetooth}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Border>

                <!-- Results List & Empty State Container -->
                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <ListBox x:Name="ResultsList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 SelectionMode="Single"
                                 MouseDoubleClick="OnResultDoubleClick">
                            <ListBox.ContextMenu>
                                <ContextMenu x:Name="ResultsContextMenu">
                                    <MenuItem Header="TÙY CHỌN TÁC VỤ" IsHitTestVisible="False" Focusable="False" FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Padding="8,4,8,4"/>
                                    <Separator Background="{DynamicResource SeparatorBrush}" Margin="0,2,0,4"/>
                                    <MenuItem Header="Thực thi mặc định" InputGestureText="Enter" Click="OnActionOpenClicked">
                                        <MenuItem.Icon>
                                            <Path Data="{StaticResource GeoEnter}" Width="14" Height="14" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Chạy với quyền Administrator" InputGestureText="Ctrl+Shift+↵" Click="OnActionRunAsAdminClicked">
                                        <MenuItem.Icon>
                                            <Path Data="{StaticResource GeoShield}" Width="14" Height="14" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Mở thư mục chứa (Explorer)" InputGestureText="Ctrl+↵" Click="OnActionOpenFolderClicked">
                                        <MenuItem.Icon>
                                            <Path Data="{StaticResource GeoFolder}" Width="14" Height="14" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Sao chép đường dẫn" InputGestureText="Ctrl+C" Click="OnActionCopyPathClicked">
                                        <MenuItem.Icon>
                                            <Path Data="{StaticResource GeoCopy}" Width="14" Height="14" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator Background="{DynamicResource SeparatorBrush}" Margin="0,4"/>
                                    <MenuItem Header="Hỏi AI giải thích chi tiết" InputGestureText="Tab" Click="OnActionAskAIClicked">
                                        <MenuItem.Icon>
                                            <Path Data="{StaticResource GeoSparkle}" Width="14" Height="14" Fill="{DynamicResource AccentBrush}" Stretch="Uniform"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator Background="{DynamicResource SeparatorBrush}" Margin="0,4"/>
                                    <MenuItem Header="Cài đặt &amp; Tùy biến" InputGestureText="Ctrl+," Click="OnSettingsClicked">
                                        <MenuItem.Icon>
                                            <Path Data="{StaticResource GeoSettings}" Width="14" Height="14" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="{DynamicResource ItemCornerRadius}" Padding="{DynamicResource ItemPadding}" Margin="{DynamicResource ItemMargin}" BorderThickness="{DynamicResource ItemBorderThickness}" BorderBrush="{DynamicResource ItemDefaultBorderBrush}">
                                                    <Grid>
                                                        <Border x:Name="ActiveIndicator"
                                                                Width="3" Height="18"
                                                                CornerRadius="{DynamicResource IndicatorCornerRadius}"
                                                                Background="{DynamicResource SelectionIndicatorBrush}"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                Margin="-7,0,0,0"
                                                                Visibility="Collapsed"/>
                                                        <ContentPresenter Margin="4,0,0,0" />
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ItemSelectedBgBrush}"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource ItemSelectedBorderBrush}"/>
                                                        <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                            <Condition Property="IsSelected" Value="False"/>
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ItemHoverBgBrush}"/>
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Squircle Icon Container: Real App Icon -> Luminous Colored Vector -> Colored Fallback Glyph -->
                                        <Border Grid.Column="0"
                                                Background="{Binding Type, Converter={StaticResource ResultTypeToBackgroundConverter}}"
                                                BorderBrush="{Binding Type, Converter={StaticResource ResultTypeToBorderConverter}}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource IconCornerRadius}"
                                                Width="{DynamicResource IconBoxSize}" Height="{DynamicResource IconBoxSize}"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <Grid>
                                                <!-- Shell/App Real Extracted Icon -->
                                                <Image x:Name="RealAppIcon"
                                                       Source="{Binding IconPath, Converter={StaticResource ResultToIconConverter}}"
                                                       Width="18" Height="18"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding Source, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToVisibilityConverter}}"/>

                                                <!-- High-Craft Colored Vector Icon (Always preferred over monochrome symbols!) -->
                                                <Path x:Name="VectorResultIcon"
                                                      Width="15" Height="15"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Fill="{Binding Type, Converter={StaticResource ResultTypeToColorConverter}}"
                                                      Data="{Binding Converter={StaticResource ResultTypeToGeometryConverter}}">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Source, ElementName=RealAppIcon}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>

                                                <!-- Fallback Glyph only if neither Image nor Vector Data resolved -->
                                                <TextBlock Text="{Binding IconGlyph}"
                                                           FontSize="14"
                                                           FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI"
                                                           Foreground="{Binding Type, Converter={StaticResource ResultTypeToColorConverter}}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Source, ElementName=RealAppIcon}" Value="{x:Null}"/>
                                                                        <Condition Binding="{Binding Data, ElementName=VectorResultIcon}" Value="{x:Null}"/>
                                                                        <Condition Binding="{Binding IconGlyph, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>

                                        <!-- Title & Subtitle -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="11.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <!-- Right Shortcut Hint -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ShortcutHint}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="10.5"
                                                   FontFamily="Segoe UI, Consolas, monospace"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,2,0"
                                                   Visibility="{Binding ShortcutHint, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Modern Minimalist No Results Empty State -->
                        <Border x:Name="NoResultsPanel"
                                Visibility="Collapsed"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Padding="24,20"
                                Margin="20">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="48" Height="48"
                                        CornerRadius="24"
                                        Background="{DynamicResource BadgeBgBrush}"
                                        BorderBrush="{DynamicResource BadgeBorderBrush}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,12">
                                    <Path Data="{StaticResource GeoSearch}"
                                          Width="20" Height="20"
                                          Stroke="{DynamicResource EmptyStateBrush}"
                                          StrokeThickness="1.8"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Str_NoResultsTitle}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource Str_NoResultsSub}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,14"/>

                                <WrapPanel HorizontalAlignment="Center" MaxWidth="520">
                                    <Border Style="{StaticResource KbdBadgeStyle}" Margin="3,3"><TextBlock Text="&gt; cmd" Style="{StaticResource KbdTextStyle}"/></Border>
                                    <TextBlock Text="Shell" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                    <Border Style="{StaticResource KbdBadgeStyle}" Margin="3,3"><TextBlock Text="calc 25*4" Style="{StaticResource KbdTextStyle}"/></Border>
                                    <TextBlock Text="Calc" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                    <Border Style="{StaticResource KbdBadgeStyle}" Margin="3,3"><TextBlock Text="ai ..." Style="{StaticResource KbdTextStyle}"/></Border>
                                    <TextBlock Text="AI" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                    <Border Style="{StaticResource KbdBadgeStyle}" Margin="3,3"><TextBlock Text="sys wifi list" Style="{StaticResource KbdTextStyle}"/></Border>
                                    <TextBlock Text="Wi-Fi / BT" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Inline Streaming Terminal Output Panel -->
                        <Border x:Name="CommandOutputPanel"
                                Visibility="Collapsed"
                                Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource SeparatorBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Command Header & Actions -->
                                <Border Grid.Row="0"
                                        BorderBrush="{DynamicResource SeparatorBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,0,0,6"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Ellipse x:Name="CmdStatusDot" Width="7" Height="7" Fill="#F59E0B" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="CmdHeaderCommandText"
                                                           Text="&gt; command"
                                                           FontFamily="Cascadia Mono, Consolas, Courier New, monospace"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="CmdHeaderMetaText"
                                                           Text=""
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="CmdStopBtn"
                                                    Click="OnCmdStopClicked"
                                                    Visibility="Collapsed"
                                                    Cursor="Hand"
                                                    ToolTip="Dừng lệnh đang chạy (Esc)"
                                                    Margin="0,0,4,0"
                                                    Background="Transparent"
                                                    BorderThickness="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="#26EF4444" BorderBrush="#55EF4444" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                            <TextBlock Text="Dừng" FontSize="11" FontWeight="SemiBold" Foreground="#F87171"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#44EF4444"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <Button x:Name="CmdCopyBtn"
                                                    Click="OnCmdCopyClicked"
                                                    Width="24" Height="24"
                                                    Margin="0,0,2,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip="Sao chép kết quả (Ctrl+C)">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                                            <Path Data="{StaticResource GeoCopy}" Width="12" Height="12" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.4" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBgBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <Button x:Name="CmdExternalBtn"
                                                    Click="OnCmdOpenExternalClicked"
                                                    Width="24" Height="24"
                                                    Margin="0,0,2,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip="Mở trong Terminal ngoài">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                                            <Path Data="{StaticResource GeoExternal}" Width="12" Height="12" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.4" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBgBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <Button x:Name="CmdCloseBtn"
                                                    Click="OnCmdCloseClicked"
                                                    Width="24" Height="24"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip="Đóng kết quả (Esc)">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                                            <Path Data="{StaticResource GeoClear}" Width="9" Height="9" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBgBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Streaming Output Area -->
                                <ScrollViewer x:Name="CommandOutputScrollViewer"
                                              Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <TextBox x:Name="CommandOutputTextBox"
                                             IsReadOnly="True"
                                             IsReadOnlyCaretVisible="True"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             FontFamily="Cascadia Mono, Consolas, Courier New, monospace"
                                             FontSize="12"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             CaretBrush="{DynamicResource AccentBrush}"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                </Grid>

                <!-- Minimal Bottom Status & Primary Shortcut Bar -->
                <Border Grid.Row="5" Visibility="{DynamicResource FooterVisibility}" Margin="0,6,0,0" Padding="2,6,2,0" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource KbdBadgeStyle}">
                                <TextBlock Text="↵" Style="{StaticResource KbdTextStyle}"/>
                            </Border>
                            <TextBlock Text="{DynamicResource Str_Footer_Open}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <Border Style="{StaticResource KbdBadgeStyle}">
                                <TextBlock Text="Tab" Style="{StaticResource KbdTextStyle}"/>
                            </Border>
                            <TextBlock Text="{DynamicResource Str_Footer_Actions}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText"
                                       Text="{DynamicResource Str_StatusReady}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Action Flyout Menu on Tab Key -->
            <Border x:Name="ActionFlyoutPanel"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,24,46"
                    Width="315"
                    Background="{DynamicResource PopupBgBrush}"
                    BorderBrush="{DynamicResource WindowBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="10,8"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Color="{DynamicResource ShadowColor}" Opacity="0.38"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="FlyoutTargetTitle" Text="TÙY CHỌN TÁC VỤ" FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="6,4,6,8" TextTrimming="CharacterEllipsis"/>

                    <Button x:Name="FlyoutRunBtn" Click="OnActionOpenClicked" Style="{StaticResource FlyoutButtonStyle}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoEnter}" Width="12" Height="12" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Thực thi mặc định" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Style="{StaticResource KbdBadgeStyle}">
                                <TextBlock Text="↵" Style="{StaticResource KbdTextStyle}"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Button x:Name="FlyoutAdminBtn" Click="OnActionRunAsAdminClicked" Style="{StaticResource FlyoutButtonStyle}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoShield}" Width="12" Height="12" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Chạy quyền Administrator" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Style="{StaticResource KbdBadgeStyle}">
                                <TextBlock Text="Ctrl+Shift+↵" Style="{StaticResource KbdTextStyle}"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Button x:Name="FlyoutFolderBtn" Click="OnActionOpenFolderClicked" Style="{StaticResource FlyoutButtonStyle}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoFolder}" Width="12" Height="12" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Mở thư mục chứa (Explorer)" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Style="{StaticResource KbdBadgeStyle}">
                                <TextBlock Text="Ctrl+↵" Style="{StaticResource KbdTextStyle}"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Button x:Name="FlyoutCopyBtn" Click="OnActionCopyPathClicked" Style="{StaticResource FlyoutButtonStyle}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoCopy}" Width="12" Height="12" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Sao chép đường dẫn" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Style="{StaticResource KbdBadgeStyle}">
                                <TextBlock Text="Ctrl+C" Style="{StaticResource KbdTextStyle}"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Separator Background="{DynamicResource SeparatorBrush}" Margin="2,4"/>

                    <Button x:Name="FlyoutAiSummarizeBtn" Click="OnActionSummarizeFileClicked" Style="{StaticResource FlyoutButtonStyle}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoBot}" Width="12" Height="12" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Tóm tắt tài liệu với AI" FontSize="12.5" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Style="{StaticResource KbdBadgeStyle}">
                                <TextBlock Text="Ctrl+Alt+S" Style="{StaticResource KbdTextStyle}"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Button x:Name="FlyoutAiBtn" Click="OnActionAskAIClicked" Style="{StaticResource FlyoutButtonStyle}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoSparkle}" Width="12" Height="12" Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Hỏi AI giải thích chi tiết" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Style="{StaticResource KbdBadgeStyle}">
                                <TextBlock Text="Tab" Style="{StaticResource KbdTextStyle}"/>
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <!-- In-App Wi-Fi Password Prompt Overlay -->
            <Border x:Name="WifiPasswordOverlay"
                    Visibility="Collapsed"
                    Background="#99000000"
                    CornerRadius="{DynamicResource WindowCornerRadius}"
                    Padding="20">
                <Border MaxWidth="360"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource PopupBgBrush}"
                        BorderBrush="{DynamicResource WindowBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="{DynamicResource ShadowColor}" Opacity="0.35"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoLock}" Width="14" Height="14" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Str_WifiModal_Title}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="WifiPasswordSsidText"
                                   Text="SSID"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,6,0,10"/>
                        <TextBlock Text="{DynamicResource Str_WifiModal_Desc}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>
                        <PasswordBox x:Name="WifiPasswordBox"
                                     Padding="10,7"
                                     FontSize="13"
                                     Background="{DynamicResource SearchBarBgBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource WindowBorderBrush}"
                                     BorderThickness="1"
                                     KeyDown="OnWifiPasswordBoxKeyDown"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button x:Name="WifiPasswordCancelBtn"
                                    Content="{DynamicResource Str_WifiModal_Cancel}"
                                    Click="OnWifiPasswordCancelClicked"
                                    Style="{StaticResource QuickSettingBtnStyle}"
                                    Padding="12,5"
                                    Margin="0,0,8,0"/>
                            <Button x:Name="WifiPasswordConnectBtn"
                                    Content="{DynamicResource Str_WifiModal_Connect}"
                                    Click="OnWifiPasswordConnectClicked"
                                    Style="{StaticResource QuickSettingBtnStyle}"
                                    Background="{DynamicResource AccentBrush}"
                                    Foreground="#FFFFFF"
                                    Padding="14,5"
                                    Margin="0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Floating Notification Toast (Positioned bottom-center above footer) -->
            <Border x:Name="ToastShelf"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,40"
                    Background="{DynamicResource PopupBgBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14,6"
                    Opacity="0"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Color="{DynamicResource ShadowColor}" Opacity="0.22"/>
                </Border.Effect>
                <TextBlock x:Name="ToastMessageText"
                           Text=""
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Bottom-Right Corner Resize Handle -->
            <Thumb x:Name="MainResizeThumb"
                   Width="16" Height="16"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,3,3"
                   Cursor="SizeNWSE"
                   ToolTip="{DynamicResource Str_ResizeGripTooltip}"
                   DragDelta="OnResizeThumbDragDelta"
                   DragCompleted="OnResizeThumbDragCompleted">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Path Data="M11 2 L2 11 M11 6 L6 11 M11 10 L10 11"
                                  Stroke="{DynamicResource TextMutedBrush}"
                                  StrokeThickness="1.3"
                                  Opacity="0.65"
                                  Width="11" Height="11"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,2,2"/>
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
